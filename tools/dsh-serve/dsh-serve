def cmd_selftest(args: argparse.Namespace) -> int:
    selected = {args.case: CASES[args.case]} if args.case else CASES
    failures = 0
    for name, case in selected.items():
        with tempfile.TemporaryDirectory(prefix=f"dsh-serve-{name}-") as tmp:
            try:
                case(Path(tmp))
                print(f"ok    {name}")
            except (Failure, AssertionError) as exc:
                print(f"FAIL  {name}: {exc}")
                failures += 1
            except (OSError, subprocess.SubprocessError, ValueError) as exc:
                print(f"ERROR {name}: {type(exc).__name__}: {exc}")
                failures += 1
    print(f"\n{len(selected) - failures}/{len(selected)} passed")
    return RC_OK if failures == 0 else RC_FAIL


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="dsh-serve", description=__doc__.splitlines()[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=f"app {APP!r} on pool {POOL!r}, always --exclusive, "
               f"registered priority {REGISTERED_PRIO!r}")
    verbs = parser.add_subparsers(dest="verb", required=True)

    start = verbs.add_parser("start", help="claim the GPU and bring the server up")
    start.add_argument("--json", action="store_true", help=JSON_HELP)
    start.add_argument("--if-not-running", action="store_true",
                       help="succeed (rc 0) when a server is ALREADY serving "
                            "the configuration this call asks for, instead of "
                            "refusing with rc 7. A server running anything "
                            "else is still rc 8 — this makes the verb "
                            "idempotent, never permissive")
    start.add_argument("--prio", choices=["operator", "interactive", "service",
                                          "batch", "fleet", "test"],
                       help=f"override the registered default ({REGISTERED_PRIO}); "
                            "an override needs a reason in --purpose")
    start.add_argument("--purpose", help="journaled; what a human reading "
                                         "`arm status` at 2am needs")
    start.add_argument("--wait", type=int, metavar="SECS",
                       help="queue for the pool instead of refusing")
    start.add_argument("--vllm-bin", default=str(DEFAULT_VLLM_BIN),
                       help=f"vllm executable (default: {DEFAULT_VLLM_BIN})")
    start.add_argument("--port", type=int, default=PORT,
                       help=f"serving port (default: {PORT}; ~/.dsh/settings.yaml "
                            "must name the same one)")
    start.add_argument("--ready-timeout", type=float,
                       default=DEFAULT_READY_TIMEOUT_S, metavar="SECS")
    start.add_argument("--vram-timeout", type=float,
                       default=VRAM_RETURN_TIMEOUT_S, metavar="SECS",
                       help="how long teardown waits for the card to come back "
                            f"before refusing to release the lease (default: "
                            f"{VRAM_RETURN_TIMEOUT_S:.0f})")
    start.add_argument("--uds", action=argparse.BooleanOptionalAction,
                       default=True,
                       help="serve vLLM on a Unix socket behind this "
                            "launcher's TCP proxy, so the port is held by a "
                            "socket that binds and listens together. Consumers "
                            "see no difference. ON by default since 2026-09-04 "
                            "(TD ruling): a census of server.log found direct "
                            "TCP unreachable on 14/20 real launches (a "
                            "measured 70%% hard-failure rate, each one holding "
                            "the GPU for up to --ready-timeout before "
                            "admitting it — see "
                            "vllm-loopback-unreachable-after-config-change), "
                            "against 0/13 for --uds over ~9 days 3 hours of "
                            "measured serving life. The soft failure classes "
                            "(a dropped mid-stream connection, a hang that "
                            "does not kill the proxy) were NOT separately "
                            "measurable — nothing here watches for them — so "
                            "this is a documented gap, not a clean bill of "
                            "health. Pass --no-uds for the old direct-TCP "
                            "path")
    start.add_argument("--model", metavar="PROFILE",
                       help="a profile name from the model register "
                            "(`dsh-serve models` lists them). Omit to use the "
                            "register's DEFAULT_PROFILE — AS3's launch line "
                            "passes none and must keep deferring to it. An "
                            "unknown name refuses loudly; it never falls back")
    start.add_argument("vllm_args", nargs="*",
                       help="extra arguments appended to the vllm command")
    start.set_defaults(func=cmd_start)

    vision = verbs.add_parser(
        "try-vision", help="start with the vision tower, prove an image "
                           "round-trips, or restore the text-only server")
    vision.add_argument("--deadline", type=float,
                        default=VISION_READY_TIMEOUT_S, metavar="SECS",
                        help="wall-clock allowance for the vision server to "
                             "answer /health before it is torn down and the "
                             f"known-good config restored (default: "
                             f"{VISION_READY_TIMEOUT_S:.0f})")
    vision.add_argument("--json", action="store_true", help=JSON_HELP)
    vision.add_argument("--if-not-running", action="store_true",
                        help="succeed (rc 0) without restarting anything when "
                             "the server already up passes the image test. The "
                             "test is always the round trip, never the recorded "
                             "arguments")
    vision.add_argument("--restore-timeout", type=float,
                        default=DEFAULT_READY_TIMEOUT_S, metavar="SECS",
                        help="readiness allowance for the restore itself "
                             f"(default: {DEFAULT_READY_TIMEOUT_S:.0f})")
    vision.add_argument("--prio", choices=["operator", "interactive", "service",
                                           "batch", "fleet", "test"])
    vision.add_argument("--purpose")
    vision.add_argument("--wait", type=int, metavar="SECS")
    vision.add_argument("--vllm-bin", default=str(DEFAULT_VLLM_BIN))
    vision.add_argument("--port", type=int, default=PORT,
                        help=f"port for the vision ATTEMPT (default: {PORT})")
    vision.add_argument("--restore-port", type=int, default=PORT,
                        help="port the known-good text-only server is restored "
                             f"on (default: {PORT}). Deliberately independent "
                             "of --port: a test on another port must not be "
                             "able to strand the chat where nothing points")
    vision.add_argument("--vram-timeout", type=float,
                        default=VRAM_RETURN_TIMEOUT_S, metavar="SECS")
    vision.add_argument("--uds", action="store_true",
                        help="run the ATTEMPT with vLLM on a Unix socket behind "
                             "this launcher's TCP proxy. The restore, if it "
                             "happens, always uses --uds regardless of this "
                             "value")
    vision.add_argument("--model", metavar="PROFILE",
                        help="a profile name from the model register for the "
                             "ATTEMPT only (`dsh-serve models` lists them). "
                             "Omit to use the register's DEFAULT_PROFILE. The "
                             "restore, if it happens, always uses "
                             "KNOWN_GOOD_PROFILE instead — never this value")
    vision.add_argument("vllm_args", nargs="*",
                        help="extra arguments for the vision ATTEMPT only "
                             "(after `--`). The restore never carries them: it "
                             "is the shipped configuration or it is not a "
                             "restore")
    vision.set_defaults(func=cmd_try_vision)

    stop = verbs.add_parser("stop", help="give the card back, and prove it")
    stop.add_argument("--timeout", type=float, default=STOP_WAIT_S, metavar="SECS")
    stop.add_argument("--json", action="store_true", help=JSON_HELP)
    stop.set_defaults(func=cmd_stop)

    status = verbs.add_parser("status", help="what this launcher is holding")
    status.add_argument("--json", action="store_true", help=JSON_HELP)
    status.set_defaults(func=cmd_status)

    models = verbs.add_parser(
        "models", help="list the model register and validate each profile "
                       "without loading it or touching the GPU")
    models.set_defaults(func=cmd_models)

    test = verbs.add_parser("selftest", help="assert the claim and the teardown")
    test.add_argument("--case", choices=sorted(CASES))
    test.set_defaults(func=cmd_selftest)

    supervise = verbs.add_parser("_supervise")
    supervise.add_argument("--vllm-bin", required=True)
    supervise.add_argument("--port", type=int, default=PORT)
    supervise.add_argument("--vram-timeout", type=float,
                           default=VRAM_RETURN_TIMEOUT_S)
    supervise.add_argument("--arbitrated", action="store_true")
    supervise.add_argument("--uds")
    supervise.add_argument("--profile", required=True,
                           help="the register profile name `start` resolved, "
                                "recorded verbatim in state.json's `profile` "
                                "field so it does not go stale once the "
                                "phase flips to serving")
    supervise.add_argument("vllm_args", nargs="*")
    supervise.set_defaults(func=cmd_supervise)

    proxy = verbs.add_parser("_proxy")
    proxy.add_argument("--port", type=int, required=True)
    proxy.add_argument("--uds", required=True)
    proxy.set_defaults(func=cmd_proxy)

    args = parser.parse_args()
    if not getattr(args, "json", False):
        return args.func(args)
    # Caught here rather than at each `die()`: a machine caller must get the
    # object on every exit path, including the refusals that never reach a
    # verb's return statement.
    try:
        rc = args.func(args)
    except SystemExit as exc:
        rc = exc.code if isinstance(exc.code, int) else RC_FAIL
    print(json.dumps(json_payload(rc)), flush=True)
    return rc


if __name__ == "__main__":
    sys.exit(main())
