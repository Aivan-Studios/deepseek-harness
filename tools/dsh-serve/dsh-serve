def case_books_absent_runs_unclaimed(tmp: Path) -> None:
    """The top row: no books, no arbiter — a fresh clone, CI, Runpod."""
    env, home = sandbox(tmp, books=False, arm=False, smi_mib="0")
    out = run_self(env, "start", "--vllm-bin", "/bin/true", "--port", free_port(),
                   "--ready-timeout", "20")
    check("UNCLAIMED" in out.stderr, f"did not announce it: {out.stderr!r}")
    check(not (tmp / "argv.log").exists(), "claimed on a box with no arbiter")
    log = (home / ".local" / "state" / "dsh-serve" / "server.log").read_text()
