def case_doc_example(_tmp: Path) -> None:
    """The consumed-surface doc's `--json` example must name the real fields.

    A drift-detection test, not a source of truth: the launcher is authoritative
    and the doc is a copy, so this asserts they agree without importing one into
    the other. It exists because the copy DID drift and a consumer built eight
    fakes from it — all agreeing with each other, all green, all wrong. Fakes
    written from the same reading as the code under test prove self-consistency
    and nothing else; only a comparison against the real payload catches this.
    """
    if not CONSUMER_DOC.exists():
        say(f"no {CONSUMER_DOC} on this box — nothing to compare against; the "
            "launcher remains authoritative either way")
        return
    text = CONSUMER_DOC.read_text()
    start = text.find("```json")
    end = text.find("```", start + 7)
    check(start != -1 and end != -1, f"no ```json example in {CONSUMER_DOC}")
    example = json.loads(text[start + 7:end])
    real = json_payload(RC_OK)
    missing = sorted(set(real) - set(example))
    invented = sorted(set(example) - set(real))
    check(not missing and not invented,
          f"{CONSUMER_DOC} §4 disagrees with the payload — "
          f"absent from the doc: {missing}; named by the doc but not emitted: "
          f"{invented}")


def case_kv_pool_coherence(tmp: Path) -> None:
    """The window and the KV pool are one decision, asserted in both directions.

    `--kv-cache-memory-bytes` makes vLLM skip memory profiling, so a pool that
    cannot hold one max-length request is not a tight fit — it is a ValueError a
    minute into startup with the GPU already claimed. Found 2026-08-24, when
    raising the window alone would have done exactly that to a live server.
    """
    env, home = sandbox(tmp, books=True, arm=True)
    _, default_profile = resolve_profile(None)
    # This checkpoint's real geometry: 64 layers, every 4th full-attention.
    model = home / "models" / default_profile["path"].name
    model.mkdir(parents=True, exist_ok=True)
    (model / "config.json").write_text(json.dumps({
        "num_hidden_layers": 64,
        "full_attention_interval": 4,
        "layer_types": ["full_attention" if (one % 4) == 3 else "linear_attention"
                        for one in range(64)],
        "num_key_value_heads": 4,
        "head_dim": 256,
    }))
    argv_log = tmp / "argv.log"

    # The shipped pair must PASS — a guard that refuses the production config
    # is worse than no guard, so this direction is asserted first.
    out = run_self(env, "start", "--vllm-bin", "/bin/true", "--port", free_port(),
                   "--ready-timeout", "20")
    check(argv_log.exists(),
          f"the shipped window/pool pair was refused by its own guard: {out.stderr!r}")
    served = [one for one in (json.loads(line) for line in
                              argv_log.read_text().splitlines())
              if one[:2] == ["run", POOL]][0]
    check(last_flag_value(served, "--max-model-len") == str(default_profile["max_model_len"]),
          f"--max-model-len is not {default_profile['max_model_len']}: {served}")
    check(last_flag_value(served, "--kv-cache-memory-bytes") ==
          str(default_profile["kv_cache_memory_bytes"]),
          f"--kv-cache-memory-bytes is not "
          f"{default_profile['kv_cache_memory_bytes']}: {served}")

    # ...and the pair that would have crashed the engine must be refused before
    # the claim. A trailing override is the shape an operator would reach for.
    argv_log.unlink()
    out = run_self(env, "start", "--vllm-bin", "/bin/true", "--port", free_port(),
                   "--ready-timeout", "20", "--",
                   "--max-model-len", "131072",
                   "--kv-cache-memory-bytes", "2147483648")
    check(out.returncode == RC_FAIL,
          f"expected rc {RC_FAIL}, got {out.returncode}: {out.stderr!r}")
    check(not argv_log.exists(),
          "an incoherent pair still took the GPU claim to ARM")
    check("131072" in out.stderr and "2147483648" in out.stderr,
          f"the refusal names neither number: {out.stderr!r}")
    # 16 full-attention layers x 4 KV heads x 256 head_dim x (K+V) x 1 byte
    # x 131072 tokens = 4 GiB, the floor the 2 GiB pool falls under.
    check(str(131072 * 16 * 4 * 256 * 2) in out.stderr,
          f"the refusal does not state what the window actually needs: {out.stderr!r}")


def case_settings_context_window(tmp: Path) -> None:
    """`check_settings_context_window` had zero selftest coverage despite being
    the check that refused a real launch (2026-09-10) — this closes that gap.

    Matched by `served_model_name`, which is now per-profile, so the discriminating
    assertion is that a settings.yaml holding BOTH profiles' entries is checked
    against the ONE entry naming the profile actually being launched: a mismatch on
    the profile NOT being started must never refuse, and a mismatch on the one that
    IS must always refuse, by name — proven in both directions on both profiles so
    this can never pass by coincidentally always refusing or always clearing.
    """
    env, home = sandbox(tmp, books=True, arm=True, smi_mib="0")
    register = load_register()
    unsloth, abliterated = register["PROFILES"]["unsloth"], register["PROFILES"]["abliterated"]
    settings = home / ".dsh" / "settings.yaml"
    argv_log = tmp / "argv.log"

    def write_settings(unsloth_window: int, abliterated_window: int) -> None:
        settings.parent.mkdir(parents=True, exist_ok=True)
        settings.write_text(
            "llm-pi-ai:\n  providers:\n    local-qwen:\n      models:\n"
            f"        - id: {unsloth['served_model_name']}\n"
            f"          contextWindow: {unsloth_window}\n"
            f"        - id: {abliterated['served_model_name']}\n"
            f"          contextWindow: {abliterated_window}\n")

    def refused(out: subprocess.CompletedProcess, profile: dict) -> bool:
        # The quoted repr, not a bare substring check: unsloth's own id
        # ("Qwen3.8-27B") is a PREFIX of abliterated's
        # ("Qwen3.8-27B-abliterated"), so a bare `in` check would read a
        # refusal naming one profile as also naming the other.
        return ("declares contextWindow" in out.stderr
                and repr(profile["served_model_name"]) in out.stderr)

    # unsloth's own entry is right, abliterated's is wrong: launching unsloth
    # (the default) must clear; launching abliterated must refuse BEFORE the
    # ARM claim, by name, never against unsloth's entry.
    write_settings(unsloth["max_model_len"], abliterated["max_model_len"] + 1)
    out = run_self(env, "start", "--vllm-bin", "/bin/true", "--port", free_port(),
                   "--ready-timeout", "20")
    check(not refused(out, unsloth) and not refused(out, abliterated),
          f"the matching (unsloth, default) profile was refused: {out.stderr!r}")
    check(argv_log.exists(), f"the matching profile never reached ARM: {out.stderr!r}")
    argv_log.unlink()

    out = run_self(env, "start", "--model", "abliterated", "--vllm-bin", "/bin/true",
                   "--port", free_port(), "--ready-timeout", "20")
    check(out.returncode == RC_FAIL,
          f"expected rc {RC_FAIL}, got {out.returncode}: {out.stderr!r}")
    check(refused(out, abliterated),
          f"the mismatched (abliterated) profile was not refused by its own "
          f"served id: {out.stderr!r}")
    check(not refused(out, unsloth),
          f"the refusal named unsloth's id instead of the profile actually "
          f"being launched: {out.stderr!r}")
    check("Refusing before claiming" in out.stderr and not argv_log.exists(),
          f"refused after the claim reached ARM, not before: {out.stderr!r}")

    # Flip it: abliterated's entry is right, unsloth's is wrong. Proves the
    # check is not silently always picking one hardcoded entry.
    write_settings(unsloth["max_model_len"] + 1, abliterated["max_model_len"])
    out = run_self(env, "start", "--model", "abliterated", "--vllm-bin", "/bin/true",
                   "--port", free_port(), "--ready-timeout", "20")
    check(not refused(out, unsloth) and not refused(out, abliterated),
          f"the matching (abliterated) profile was refused: {out.stderr!r}")
    check(argv_log.exists(), f"the matching profile never reached ARM: {out.stderr!r}")
    argv_log.unlink()

    out = run_self(env, "start", "--vllm-bin", "/bin/true", "--port", free_port(),
                   "--ready-timeout", "20")
    check(out.returncode == RC_FAIL,
          f"expected rc {RC_FAIL}, got {out.returncode}: {out.stderr!r}")
    check(refused(out, unsloth),
          f"the mismatched (unsloth, default) profile was not refused by its "
          f"own served id: {out.stderr!r}")
    check(not refused(out, abliterated),
          f"the refusal named abliterated's id instead of the profile "
          f"actually being launched: {out.stderr!r}")
    check(not argv_log.exists(), "an incoherent pairing still reached ARM")


def case_pgroup(_tmp: Path) -> None:
    """The measurement the whole design rests on, with a GPU-free stand-in:
    a wrapper's direct child can exit while its grandchild lives on, and only
    the recorded process group reaps both."""
    stand_in = (
        "import os, sys, time\n"
        "pid = os.fork()\n"
        "if pid == 0:\n"
        "    time.sleep(600)\n"
        "    os._exit(0)\n"
        "print(pid, flush=True)\n"
        "time.sleep(float(sys.argv[1]))\n"
    )

    def spawn(linger: str):
        child = subprocess.Popen([sys.executable, "-c", stand_in, linger],
                                 stdout=subprocess.PIPE, text=True,
                                 start_new_session=True)
        return child, int(child.stdout.readline().strip())

    # A: the hazard — `arm run`'s exact wait, returning over a live grandchild.
    child, grandchild = spawn("0.5")
    child.wait()
    check(pid_alive(grandchild),
          "the stand-in grandchild did not outlive its parent, so this probe "
          "cannot speak for VLLM::EngineCore")
    os.killpg(os.getpgid(grandchild), signal.SIGKILL)

    # B: the fix — kill the recorded group before reaping, and it empties.
    child, grandchild = spawn("600")
    pgid = os.getpgid(child.pid)
    check(pgid == child.pid, f"child is not its own group leader: {pgid}")
    check(grandchild in pgid_members(pgid), "grandchild is outside the group")
    os.killpg(pgid, signal.SIGTERM)
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline and pgid_members(pgid):
        time.sleep(0.05)
    left = pgid_members(pgid)
    child.wait()
    check(not left, f"killpg left members behind: {left}")
    check(not pid_alive(grandchild), "killpg did not reach the grandchild")


def case_vision_probe_asserts_on_the_answer(tmp: Path) -> None:
    """⭐ A 200 is not a pass.

    The whole reason `try-vision` exists is that the image path was never proven,
    so its probe must fail a server that answers cheerfully with the wrong
    colour. If this case ever goes green on a stub that ignores the image, the
    verb has stopped testing anything.
    """
    # Test-only dependencies, kept out of the module's runtime imports.
    import http.server
    import threading

    png = solid_png(8, 8, VISION_PROBE_RGB)
    check(png.startswith(b"\x89PNG\r\n\x1a\n"), "probe image is not a PNG")
    for tag in (b"IHDR", b"IDAT", b"IEND"):
        check(tag in png, f"probe PNG has no {tag.decode()} chunk")
    body = png[png.index(b"IDAT") + 4:]
    check(len(zlib.decompress(body[:-12])) == 8 * (8 * 3 + 1),
          "probe PNG pixel data does not decode to one filter byte per row")

    replies: list[str] = []

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_POST(self) -> None:
            self.rfile.read(int(self.headers.get("Content-Length", 0)))
            payload = replies.pop(0).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)

        def log_message(self, *_args) -> None:
            pass

    def reply(content: str) -> str:
        return json.dumps({"choices": [{"message": {"content": content}}],
                           "usage": {"prompt_tokens": 90}})

    server = http.server.HTTPServer((HOST, 0), Handler)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    try:
        port = server.server_address[1]
        replies.append(reply("blue"))
        passed, detail = image_probe(port, "test-model", timeout=20)
        check(not passed, f"passed a 200 that named the wrong colour: {detail}")

        replies.append(reply(""))
        passed, detail = image_probe(port, "test-model", timeout=20)
        check(not passed, f"passed an empty answer: {detail}")

        # Both directions, so the case can never pass by always refusing.
        replies.append(reply("Red."))
        passed, detail = image_probe(port, "test-model", timeout=20)
        check(passed, f"failed the right answer: {detail}")
    finally:
        server.shutdown()
        server.server_close()
        thread.join(timeout=10)


def case_vision_captures_then_restores(tmp: Path) -> None:
    """The guarded start's promise: on a server that comes up and never answers,
    capture the evidence FIRST, then put the text-only config back.

    The discriminating assertion is on the second claim's argv — a restore that
    carried the vision flag would be a restore in name only.
    """
    # Unarbitrated on purpose: the recording `arm` double exits immediately, so
    # under it the wrapper is never alive long enough to reach the readiness
    # TIMEOUT — `start` would leave through its early-exit path instead, and the
    # capture this case exists to assert would never run. With no books the
    # supervisor IS the wrapper, stays up with its child, and the deadline is
    # what ends the attempt. `case_argv` covers the claim itself.
    env, home = sandbox(tmp, books=False, arm=False, smi_mib="0")
    served = tmp / "serve-argv.log"
    # A "vllm" that records how it was invoked, stays up and never serves: the
    # exact shape of the gremlin. Its own argv is the composed serving command,
    # which is more direct evidence than the claim wrapped around it.
    # An absolute interpreter for the same reason the `arm` double uses one: the
    # sandbox PATH holds only the doubles, so a `/bin/sh` script calling `sleep`
    # would die rc=127 and leave through the early-exit path instead.
    mute = tmp / "mute-vllm"
    mute.write_text(
        f"#!{sys.executable}\n"
        "import sys, time\n"
        f"open({str(served)!r}, 'a').write(' '.join(sys.argv[1:]) + '\\n')\n"
        "time.sleep(90)\n")
    mute.chmod(0o755)

    try:
        # Two different ports on purpose: the attempt's and the shipped one. If
        # the kernel ever handed back the same one twice the port assertions
        # below would pass without discriminating anything, so insist.
        attempt_port, restore_port = free_port(), free_port()
        while restore_port == attempt_port:
            restore_port = free_port()
        out = run_self(env, "try-vision", "--vllm-bin", str(mute),
                       "--port", attempt_port, "--restore-port", restore_port,
                       "--deadline", "12", "--restore-timeout", "12",
                       "--", "--mm-processor-cache-gb", "0",
                       timeout=420)

        invocations = served.read_text().splitlines() if served.exists() else []
        check(len(invocations) == 2,
              f"expected a vision attempt then a restore, got {invocations}")
        # ⚠️ The defect this guards: `restore_known_good` used to inherit the
        # attempt's port, so a test on another port would have put the
        # operator's chat back where nothing points at it.
        check(f"--port {attempt_port}" in invocations[0],
              f"the attempt did not use the test port: {invocations[0]}")
        # The restore's engine argv no longer carries --port at all now that
        # the restore hardcodes --uds (2026-09-04): `vllm_args()` drops
        # --host/--port in favor of --uds, and the TCP port belongs to the
        # proxy instead. state.json's `port` field is what the supervisor
        # actually claimed to serve on, transport-independent — check that
        # rather than the engine's own argv.
        state = json.loads(
            (home / ".local" / "state" / "dsh-serve" / "state.json").read_text())
        check(str(state.get("port")) == str(restore_port),
              f"the restore did not land on the shipped port {restore_port} — it "
              f"would strand the chat: {state}")
        # An experiment flag belongs to the attempt alone. A restore carrying it
        # would quietly ship whatever was being tested.
        check("--mm-processor-cache-gb 0" in invocations[0],
              f"the attempt dropped its experiment arguments: {invocations[0]}")
        check("--mm-processor-cache-gb" not in invocations[1],
              f"the restore inherited an experiment flag: {invocations[1]}")
        check("--no-language-model-only" in invocations[0],
              f"the vision attempt did not turn the tower on: {invocations[0]}")
        check("--no-language-model-only" not in invocations[1],
              f"the restore carried the vision flag, so it is not the known-good "
              f"config: {invocations[1]}")
        check("--language-model-only" in invocations[1],
              f"the restore is not the shipped text-only config: {invocations[1]}")

        captures = sorted((home / ".local" / "state" / "dsh-serve" / "unreachable")
                          .glob("unreachable-*.txt"))
        check(captures, "restored without capturing any evidence first")
        text = captures[0].read_text()
        for heading in ("connect attempt", "kernel counter DELTA",
                        "listener for this port"):
            check(heading in text,
                  f"capture has no {heading!r} section: {text[:400]!r}")

        check(out.returncode == RC_RESTORE_FAILED,
              f"expected rc {RC_RESTORE_FAILED} when the restore cannot come up "
              f"either, got {out.returncode}: {out.stderr!r}")
        check("RESTORE FAILED" in out.stderr or "RESTORE BLOCKED" in out.stderr,
              f"a chat left down was not announced loudly: {out.stderr!r}")
    finally:
        # RC_RESTORE_FAILED deliberately leaves the failed restore running for a
        # human, so this case must reap it — by the pid the launcher recorded,
        # never by pattern.
        stale = json.loads(
            (home / ".local" / "state" / "dsh-serve" / "state.json").read_text()
        ) if (home / ".local" / "state" / "dsh-serve" / "state.json").exists() else {}
        for pid in (stale.get("vllm_pgid"), stale.get("supervisor_pid")):
            if not pid:
                continue
            try:
                os.killpg(pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError, OSError):
                try:
                    os.kill(pid, signal.SIGKILL)
                except (ProcessLookupError, OSError):
                    pass


def uds_upstream(path: Path, chunks: list[bytes], delay: float):
    """A Unix-socket stand-in for vLLM that dribbles a response out over time."""
    import threading

    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    listener.bind(str(path))
    listener.listen(8)

    def one(conn: socket.socket) -> None:
        with conn:
            try:
                if not conn.recv(PROXY_CHUNK):
                    return          # a readiness probe that connected and left
                conn.sendall(b"HTTP/1.1 200 OK\r\n"
                             b"Content-Type: text/event-stream\r\n\r\n")
                for chunk in chunks:
                    time.sleep(delay)
                    conn.sendall(chunk)
            except OSError:
                return

    def serve() -> None:
        # A loop, not a single accept: `spawn_proxy`'s readiness probe opens a
        # connection of its own through the proxy, and it must not consume the
        # one the test itself needs.
        while True:
            try:
                conn, _ = listener.accept()
            except OSError:
                return
            threading.Thread(target=one, args=(conn,), daemon=True).start()

    threading.Thread(target=serve, daemon=True).start()
    return listener


def spawn_proxy(port: str, uds: Path) -> subprocess.Popen:
    """The shipped `_proxy` verb, launched the way the supervisor launches it."""
    proxy = subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "_proxy",
         "--port", str(port), "--uds", str(uds)],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        probe = socket.socket()
        probe.settimeout(0.5)
        try:
            probe.connect((HOST, int(port)))
            probe.close()
            return proxy
        except OSError:
            probe.close()
            time.sleep(0.1)
    proxy.kill()
    raise Failure(f"proxy never listened on {HOST}:{port}")


def case_proxy_streams(tmp: Path) -> None:
    """⭐ The proxy must RELAY a stream, not accumulate it.

    Chat traffic is streamed token by token. A proxy that buffered whole
    responses would pass every health check and the vision colour probe while
    turning live output into a silence followed by a wall of text — a
    regression neither of those can see, which is why it is asserted here.
    """
    uds = tmp / "upstream.sock"
    chunks = [b"data: one\n\n", b"data: two\n\n", b"data: three\n\n"]
    delay = 0.4
    listener = uds_upstream(uds, chunks, delay)
    port = free_port()
    proxy = spawn_proxy(port, uds)
    try:
        client = socket.create_connection((HOST, int(port)), timeout=15)
        client.settimeout(15)
        client.sendall(b"POST /v1/chat/completions HTTP/1.1\r\n"
                       b"Host: localhost\r\nContent-Length: 0\r\n\r\n")
        first = last = None
        body = b""
        started = time.monotonic()
        while True:
            try:
                data = client.recv(PROXY_CHUNK)
            except (TimeoutError, socket.timeout):
                break
            if not data:
                break
            now = time.monotonic() - started
            first = now if first is None else first
            last = now
            body += data
            if all(chunk in body for chunk in chunks):
                break
        client.close()

        check(first is not None, "nothing came back through the proxy")
        for chunk in chunks:
            check(chunk in body, f"{chunk!r} never arrived: {body!r}")
        # The upstream finishes writing at ~len(chunks)*delay. A buffering proxy
        # delivers everything in one burst at the end, so first and last arrival
        # would coincide; a relaying one spreads them across the whole window.
        spread = last - first
        check(spread > delay,
              f"arrivals spanned only {spread:.2f}s across a "
              f"{len(chunks) * delay:.1f}s stream — the proxy is buffering, "
              "not relaying")
    finally:
        proxy.terminate()
        proxy.wait(timeout=10)
        listener.close()


def case_proxy_death_refuses(tmp: Path) -> None:
    """A dead proxy must look like a dead server: refused, never a hang.

    This is why the proxy is a separate process. If it were a thread, its death
    would leave the supervisor holding the listening socket and consumers would
    hang against something that no longer relays — the silent failure.
    """
    uds = tmp / "upstream.sock"
    listener = uds_upstream(uds, [b"data: x\n\n"], 0.0)
    port = free_port()
    proxy = spawn_proxy(port, uds)
    proxy.terminate()
    proxy.wait(timeout=10)
    listener.close()

    probe = socket.socket()
    probe.settimeout(5)
    started = time.monotonic()
    try:
        probe.connect((HOST, int(port)))
        raise Failure(f"{HOST}:{port} still accepted after the proxy died")
    except (TimeoutError, socket.timeout):
        raise Failure(f"{HOST}:{port} HUNG after the proxy died; it must refuse")
    except ConnectionRefusedError:
        elapsed = time.monotonic() - started
        check(elapsed < 2.0, f"refusal took {elapsed:.1f}s; should be immediate")
    finally:
        probe.close()


def case_proxy_thinking_rewrite(tmp: Path) -> None:
    """The proxy must turn thinking off for the auto-mode classifier — and only there.

    The vLLM Anthropic adapter drops the harness's `thinking` parameter, and
    the Qwen template thinks by default: without this rewrite the classifier's
    ~35k-token prompt burns its 61 s deadline in reasoning and every gated tool
    call stalls with "temporarily unavailable (timed out)". Normal requests
    must come through byte-identical.
    """
    import socket
    import threading

    uds = tmp / "rewrite.sock"
    seen: list[bytes] = []
    seen_request_lines: list[str] = []
    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    listener.bind(str(uds))
    listener.listen(8)

    def one(conn: socket.socket) -> None:
        with conn:
            try:
                head = b""
                while b"\r\n\r\n" not in head:
                    part = conn.recv(PROXY_CHUNK)
                    if not part:
                        return
                    head += part
                head_text, rest = head.split(b"\r\n\r\n", 1)
                lines = head_text.decode("latin-1").split("\r\n")
                seen_request_lines.append(lines[0])
                length = 0
                for line in lines[1:]:
                    key, sep, value = line.partition(":")
                    if sep and key.strip().lower() == "content-length":
                        length = int(value)
                body = rest
                while len(body) < length:
                    part = conn.recv(length - len(body))
                    if not part:
                        return
                    body += part
                seen.append(body)
                conn.sendall(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n"
                             b"Connection: close\r\n\r\nok")
            except OSError:
                return

    def serve() -> None:
        while True:
            try:
                conn, _ = listener.accept()
            except OSError:
                return
            threading.Thread(target=one, args=(conn,), daemon=True).start()

    threading.Thread(target=serve, daemon=True).start()
    port = free_port()
    proxy = spawn_proxy(port, uds)
    try:
        def post(body: dict) -> bytes:
            raw = json.dumps(body).encode("utf-8")
            with socket.create_connection((HOST, int(port)), timeout=15) as client:
                client.sendall(b"POST /v1/messages HTTP/1.1\r\n"
                               b"Host: localhost\r\n"
                               b"Content-Length: " + str(len(raw)).encode()
                               + b"\r\n\r\n" + raw)
                return client.recv(65536)

        # 1. The classifier: system prompt carries the harness's signature.
        response = post({"model": "Qwen3.8-27B", "max_tokens": 8,
                         "system": [
                             {"type": "text", "text": "harness prelude"},
                             {"type": "text",
                              "text": PROXY_CLASSIFIER_PREFIX + " ..."},
                         ],
                         "thinking": {"type": "adaptive"}})
        check(b"ok" in response,
              f"classifier request got no response: {response!r}")
        check(seen_request_lines[0] == "POST /v1/messages HTTP/1.1",
              f"request line was not forwarded: {seen_request_lines[0]!r}")
        rewritten = json.loads(seen[0])
        check(rewritten.get("chat_template_kwargs", {})
              .get("enable_thinking") is False,
              f"classifier request was not rewritten: {seen[0]!r}")

        # 2. An explicit thinking:disabled outside the classifier.
        post({"model": "Qwen3.8-27B", "system": "plain",
              "thinking": {"type": "disabled"}})
        check(json.loads(seen[1]).get("chat_template_kwargs", {})
              .get("enable_thinking") is False,
              f'thinking:"disabled" was not honoured: {seen[1]!r}')

        # 3. Normal agent traffic: byte-identical, no knob injected.
        plain = {"model": "Qwen3.8-27B", "system": "plain",
                 "thinking": {"type": "adaptive"},
                 "messages": [{"role": "user", "content": "hello"}]}
        post(plain)
        check(seen[2] == json.dumps(plain).encode("utf-8"),
              f"an unmarked request was rewritten: {seen[2]!r}")
    finally:
        proxy.terminate()
        proxy.wait(timeout=10)
        listener.close()


def case_proxy_admission_shadow(_tmp: Path) -> None:
    """Shadow metadata is bounded, downgraded safely, and never forwarded."""
    ordinary = json.dumps({"model": "Qwen3.8-27B",
                           "messages": [{"role": "user", "content": "hi"}]}).encode()
    headers = ["Host: localhost", "X-Aivan-Work-Class: background",
               "X-Aivan-Tenant: fleet-fe", "X-Aivan-Purpose: subagent",
               "X-Aivan-Request-Id: opaque-1", "Content-Length: 12"]
    metadata = shadow_metadata("/v1/chat/completions", headers, ordinary)
    check(metadata["class"] == "background" and metadata["purpose"] == "subagent"
          and metadata["source"] == "explicit" and not metadata["invalid"],
          f"valid scheduling metadata was not retained in shadow: {metadata!r}")
    check(metadata["tenant"] != "fleet-fe" and len(metadata["tenant"]) == 12,
          f"raw tenant escaped into shadow metadata: {metadata!r}")
    forwarded = build_request_head("POST", "/v1/chat/completions", headers, ordinary)
    check(b"x-aivan-" not in forwarded.lower(),
          f"scheduling headers reached the backend: {forwarded!r}")

    invalid = shadow_metadata("/v1/chat/completions",
                              ["X-Aivan-Work-Class: urgent",
                               "X-Aivan-Tenant: attacker"], ordinary)
    check(invalid["class"] == "agent" and invalid["source"] == "downgraded"
          and invalid["purpose"] == "invalid-metadata" and invalid["invalid"],
          f"invalid metadata did not fail safe: {invalid!r}")

    classifier = json.dumps({
        "system": PROXY_CLASSIFIER_PREFIX + " ...",
        "messages": [{"role": "user", "content": "allow?"}],
    }).encode()
    control = shadow_metadata("/v1/messages",
                              ["X-Aivan-Work-Class: background",
                               "X-Aivan-Purpose: misleading"], classifier)
    check(control["class"] == "control"
          and control["purpose"] == "permission-classifier"
          and control["source"] == "classifier",
          f"known classifier was not bounded control work: {control!r}")

    legacy = shadow_metadata("/v1/chat/completions", [], ordinary)
    check(legacy["class"] == "agent" and legacy["source"] == "legacy",
          f"unmarked request did not take the safe legacy default: {legacy!r}")

    check(is_inference_request("POST", "/v1/messages?beta=true"),
          "Anthropic generation was omitted from admission")
    check(is_inference_request("POST", "/v1/chat/completions"),
          "OpenAI chat generation was omitted from admission")
    check(not is_inference_request("POST", "/v1/messages/count_tokens?beta=true"),
          "token counting polluted inference admission capacity")
    check(not is_inference_request("GET", "/v1/messages"),
          "a non-generation method polluted inference admission capacity")


def case_proxy_admission_phase2(_tmp: Path) -> None:
    """Weighted admission, permits, expiry, and cancellation release slots."""
    def metadata(work_class: str, tenant: str, request_id: str,
                 deadline_ms: int = 1000) -> dict:
        return {"class": work_class, "purpose": "selftest",
                "source": "explicit", "tenant": tenant,
                "tenant_raw": tenant, "request_id": request_id,
                "deadline_ms": deadline_ms, "invalid": False}

    async def exercise() -> None:
        controller = AdmissionController()
        first = metadata("background", "one", "first")
        second = metadata("background", "one", "second")
        agent = metadata("agent", "agent", "agent")

        await controller.enter(first)
        await controller.enter(agent)
        queued = asyncio.create_task(controller.enter(second))
        await asyncio.sleep(0)
        check(not queued.done() and controller.queued == 1,
              "same-tenant background request did not queue")
        queued.cancel()
        try:
            await queued
        except asyncio.CancelledError:
            pass
        check(controller.queued == 0,
              "cancelled background request remained queued")

        oversized = metadata("background", "one", "oversized")
        try:
            await controller.enter(oversized,
                                   PROXY_MAX_QUEUED_BODY_BYTES + 1)
            check(False, "oversized queued request was admitted")
        except AdmissionOverload as error:
            check(error.code == "ADMISSION_QUEUE_FULL",
                  f"oversized queue body returned the wrong code: {error.code}")
        check(controller.queued_body_bytes == 0,
              "rejected queue body polluted the byte accounting")

        class ClosedClient:
            async def read(self, _size: int) -> bytes:
                await asyncio.sleep(0)
                return b""

        disconnected = await while_client_connected(
            controller.enter(second), ClosedClient())
        check(disconnected is None and controller.queued == 0,
              "disconnected client retained a background queue entry")
        check(controller.queued_body_bytes == 0,
              "disconnected client retained queued body bytes")

        await controller.release(first)
        permit_metadata = metadata("background", "two", "permit")
        token, _waited = await controller.reserve(permit_metadata)
        consumed = await controller.consume(token, permit_metadata)
        check(consumed["request_id"] == "permit",
              "permit lost its bound request identity")
        try:
            await controller.consume(token, permit_metadata)
            check(False, "single-use permit was consumed twice")
        except AdmissionOverload as error:
            check(error.code == "ADMISSION_PERMIT_INVALID",
                  f"permit reuse returned the wrong code: {error.code}")
        await controller.release(consumed)
        await controller.release(agent)
        check(controller.active == 0,
              f"admission slots leaked after release: {controller.active}")

        expiring = metadata("background", "expiry", "expiry")
        expiring_token, _ = await controller.reserve(expiring)
        await controller.revoke(expiring_token)
        check(controller.active == 0 and not controller.permits,
              "revoked permit retained a reservation")

        scheduler = AdmissionController()
        hold_one = metadata("agent", "hold-one", "hold-one")
        hold_two = metadata("agent", "hold-two", "hold-two")
        await scheduler.enter(hold_one)
        await scheduler.enter(hold_two)
        background = metadata("background", "background", "background")
        queued_agent = metadata("agent", "queued-agent", "queued-agent")
        interactive = metadata("interactive", "interactive", "interactive")
        background_task = asyncio.create_task(scheduler.enter(background))
        agent_task = asyncio.create_task(scheduler.enter(queued_agent))
        interactive_task = asyncio.create_task(scheduler.enter(interactive))
        await asyncio.sleep(0)
        check(scheduler.queued == 3,
              "global two-request cap did not queue every later class")
        state = await scheduler.snapshot()
        check(state["active"] == 2 and state["queued"] == 3
              and state["activeByClass"]["agent"] == 2
              and state["queuedByClass"] == {
                  "control": 0, "interactive": 1,
                  "agent": 1, "background": 1,
              }, f"admission status snapshot is wrong: {state!r}")
        await scheduler.release(hold_one)
        await asyncio.sleep(0)
        queued_ids = {entry["metadata"]["request_id"]
                      for entry in scheduler.queue}
        check("interactive" not in queued_ids
              and "queued-agent" in queued_ids
              and "background" in queued_ids,
              "weighted scheduler did not select interactive first")
        await interactive_task
        await scheduler.release(interactive)
        await asyncio.sleep(0)
        queued_ids = {entry["metadata"]["request_id"]
                      for entry in scheduler.queue}
        check("queued-agent" not in queued_ids
              and "background" in queued_ids,
              "weighted scheduler did not select agent second")
        await agent_task
        await scheduler.release(queued_agent)
        await background_task
        await scheduler.release(background)
        await scheduler.release(hold_two)
        check(scheduler.active == 0 and scheduler.queued == 0,
              "weighted scheduler leaked active or queued work")

        tenant_scheduler = AdmissionController()
        tenant_one = metadata("background", "tenant-one", "tenant-one")
        tenant_hold = metadata("agent", "tenant-hold", "tenant-hold")
        await tenant_scheduler.enter(tenant_one)
        await tenant_scheduler.enter(tenant_hold)
        same_tenant = asyncio.create_task(tenant_scheduler.enter(
            metadata("background", "tenant-one", "same-tenant")))
        other_metadata = metadata("background", "tenant-two", "other-tenant")
        other_tenant = asyncio.create_task(tenant_scheduler.enter(other_metadata))
        await asyncio.sleep(0)
        await tenant_scheduler.release(tenant_hold)
        await asyncio.sleep(0)
        queued_ids = {entry["metadata"]["request_id"]
                      for entry in tenant_scheduler.queue}
        check("other-tenant" not in queued_ids
              and "same-tenant" in queued_ids,
              "blocked background tenant prevented an eligible peer")
        await other_tenant
        await tenant_scheduler.release(other_metadata)
        check(any(entry["metadata"]["request_id"] == "same-tenant"
                  for entry in tenant_scheduler.queue),
              "same tenant exceeded its active background bound")
        await tenant_scheduler.release(tenant_one)
        await same_tenant
        await tenant_scheduler.release(
            metadata("background", "tenant-one", "same-tenant"))

        now = time.monotonic()
        aged_background = {"metadata": background,
                           "enqueued_at": now - 121}
        aged_agent = {"metadata": queued_agent,
                      "enqueued_at": now - 61}
        check(scheduler._effective_class(aged_background, now) == "agent",
              "background ageing did not promote its service share")
        check(scheduler._effective_class(aged_agent, now) == "interactive",
              "agent ageing did not promote its service share")

        deadline_scheduler = AdmissionController()
        await deadline_scheduler.enter(hold_one)
        await deadline_scheduler.enter(hold_two)
        try:
            await deadline_scheduler.enter(
                metadata("interactive", "deadline", "deadline", 1))
            check(False, "expired queued request was admitted")
        except AdmissionOverload as error:
            check(error.code == "ADMISSION_DEADLINE_EXCEEDED",
                  f"queue expiry returned the wrong code: {error.code}")
        check(deadline_scheduler.queued == 0
              and deadline_scheduler.active == 2,
              "queue expiry corrupted scheduler accounting")
        await deadline_scheduler.release(hold_one)
        await deadline_scheduler.release(hold_two)

        oversized_reader = asyncio.StreamReader()
        oversized_reader.feed_data(
            b"POST /v1/messages HTTP/1.1\r\nContent-Length: "
            + str(PROXY_MAX_REQUEST_BODY_BYTES + 1).encode("ascii")
            + b"\r\n\r\n")
        oversized_reader.feed_eof()
        try:
            await read_http_request(oversized_reader)
            check(False, "oversized request body declaration was accepted")
        except ValueError as error:
            check("proxy limit" in str(error),
                  f"oversized request failed for the wrong reason: {error}")

    asyncio.run(exercise())


def case_proxy_never_outlives_server(tmp: Path) -> None:
    """The proxy must not survive the server it fronts.

    An orphan proxy left holding the consumers' port would accept connections
    and relay them into a socket with nothing behind it — a port that looks
    served and is not, and one that would block the next start.
    """
    env, home = sandbox(tmp, books=False, arm=False, smi_mib="0")
    mute = tmp / "mute-vllm"
    mute.write_text(f"#!{sys.executable}\nimport time\ntime.sleep(120)\n")
    mute.chmod(0o755)
    uds = tmp / "vllm.sock"
    port = free_port()

    supervisor = subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "_supervise",
         "--vllm-bin", str(mute), "--port", port, "--uds", str(uds),
         "--vram-timeout", "3", "--profile", "unsloth"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env)
    state = home / ".local" / "state" / "dsh-serve" / "state.json"
    try:
        proxy_pid = None
        deadline = time.monotonic() + 30
        while time.monotonic() < deadline:
            if state.exists():
                try:
                    proxy_pid = json.loads(state.read_text()).get("proxy_pid")
                except ValueError:
                    proxy_pid = None
                if proxy_pid:
                    break
            time.sleep(0.2)
        check(proxy_pid is not None, "supervisor recorded no proxy_pid")
        check(pid_alive(proxy_pid), f"proxy {proxy_pid} is not running")
        # The port answers at TCP level from the start — that is the point.
        probe = socket.socket()
        probe.settimeout(5)
        probe.connect((HOST, int(port)))
        probe.close()

        supervisor.terminate()
        supervisor.wait(timeout=60)

        check(not pid_alive(proxy_pid),
              f"proxy {proxy_pid} outlived the supervisor — it still holds "
              f"{HOST}:{port}")
        after = socket.socket()
        after.settimeout(5)
        try:
            after.connect((HOST, int(port)))
            raise Failure(f"{HOST}:{port} still accepts after teardown")
        except ConnectionRefusedError:
            pass
        except (TimeoutError, socket.timeout):
            raise Failure(f"{HOST}:{port} hangs after teardown; must refuse")
        finally:
            after.close()
    finally:
        if supervisor.poll() is None:
            supervisor.kill()
            supervisor.wait()


def case_restore_hardcodes_uds(tmp: Path) -> None:
    """⛔ The restore's transport is hardcoded, never inherited from the attempt.

    Flipped 2026-09-04: known good is now `--uds` (13/13 reachable across this
    box's history, against direct TCP's 4/6 on classified restores). Running
    the attempt on direct TCP — the opposite of the restore's hardcoded value —
    proves the restore is not simply copying whatever the attempt used.
    """
    env, home = sandbox(tmp, books=False, arm=False, smi_mib="0")
    served = tmp / "serve-argv.log"
    mute = tmp / "mute-vllm"
    mute.write_text(
        f"#!{sys.executable}\n"
        "import sys, time\n"
        f"open({str(served)!r}, 'a').write(' '.join(sys.argv[1:]) + '\\n')\n"
        "time.sleep(90)\n")
    mute.chmod(0o755)
    port = free_port()

    try:
        run_self(env, "try-vision", "--vllm-bin", str(mute),
                 "--port", port, "--restore-port", port,
                 "--deadline", "12", "--restore-timeout", "12", timeout=420)

        invocations = served.read_text().splitlines() if served.exists() else []
        check(len(invocations) == 2,
              f"expected an attempt then a restore, got {invocations}")
        check("--uds" not in invocations[0],
              f"the attempt was not direct TCP as configured: {invocations[0]}")
        check(f"--host {HOST}" in invocations[0] and "--port" in invocations[0],
              f"the attempt is not direct TCP: {invocations[0]}")
        check("--uds" in invocations[1],
              f"the restore did not use --uds — it is hardcoded on regardless "
              f"of the attempt's transport: {invocations[1]}")
        check("--host" not in invocations[1],
              f"the restore kept a TCP bind alongside --uds: {invocations[1]}")
    finally:
        path = home / ".local" / "state" / "dsh-serve" / "state.json"
        stale = json.loads(path.read_text()) if path.exists() else {}
        for pid in (stale.get("proxy_pid"), stale.get("vllm_pgid"),
                    stale.get("supervisor_pid")):
            if not pid:
                continue
            for killer in (os.killpg, os.kill):
                try:
                    killer(pid, signal.SIGKILL)
                    break
                except (ProcessLookupError, PermissionError, OSError):
                    continue


def case_restore_ignores_the_failed_profile(tmp: Path) -> None:
    """⛔ The invariant `restore_known_good` exists to hold: whichever profile
    the failed attempt asked for, the restore always comes back serving
    `KNOWN_GOOD_PROFILE`'s OWN id — never the id the failed attempt was
    trying to serve. `start_namespace`'s `model` keyword being required is
    the code-level guard against this; this case is what actually exercises
    it with two profiles that answer under DIFFERENT names. Before per-profile
    served ids this was unprovable — every profile answered under the same
    name, so a restore that silently inherited the attempt's profile would
    have looked identical to a correct one.
    """
    env, home = sandbox(tmp, books=False, arm=False, smi_mib="0")
    served = tmp / "serve-argv.log"
    mute = tmp / "mute-vllm"
    mute.write_text(
        f"#!{sys.executable}\n"
        "import sys, time\n"
        f"open({str(served)!r}, 'a').write(' '.join(sys.argv[1:]) + '\\n')\n"
        "time.sleep(90)\n")
    mute.chmod(0o755)

    register = load_register()
    known_good_id = register["PROFILES"][register["KNOWN_GOOD_PROFILE"]]["served_model_name"]
    attempt_id = register["PROFILES"]["abliterated"]["served_model_name"]
    check(attempt_id != known_good_id,
          "the attempt and restore profiles must serve different ids for "
          "this case to discriminate anything")

    try:
        attempt_port, restore_port = free_port(), free_port()
        while restore_port == attempt_port:
            restore_port = free_port()
        out = run_self(env, "try-vision", "--vllm-bin", str(mute),
                       "--model", "abliterated",
                       "--port", attempt_port, "--restore-port", restore_port,
                       "--deadline", "12", "--restore-timeout", "12", timeout=420)

        invocations = served.read_text().splitlines() if served.exists() else []
        check(len(invocations) == 2,
              f"expected an attempt then a restore, got {invocations}")
        check(f"--served-model-name {attempt_id}" in invocations[0],
              f"the attempt did not serve the abliterated profile's own id: "
              f"{invocations[0]}")
        check(f"--served-model-name {known_good_id}" in invocations[1],
              f"the restore did not serve KNOWN_GOOD_PROFILE's own id — it "
              f"may have inherited the failed attempt's profile instead: "
              f"{invocations[1]}")
        check(f"--served-model-name {attempt_id}" not in invocations[1],
              f"the restore served the FAILED profile's id: {invocations[1]}")
        check(out.returncode == RC_RESTORE_FAILED,
              f"expected rc {RC_RESTORE_FAILED}, got {out.returncode}: "
              f"{out.stderr!r}")
    finally:
        path = home / ".local" / "state" / "dsh-serve" / "state.json"
        stale = json.loads(path.read_text()) if path.exists() else {}
        for pid in (stale.get("vllm_pgid"), stale.get("supervisor_pid")):
            if not pid:
                continue
            try:
                os.killpg(pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError, OSError):
                try:
                    os.kill(pid, signal.SIGKILL)
                except (ProcessLookupError, OSError):
                    pass


