_REGISTER_CACHE: dict | None = None


def load_register() -> dict:
    """The model register's namespace (PROFILES, DEFAULT_PROFILE,
    KNOWN_GOOD_PROFILE), read fresh via `git show` on first use per process and
    cached after.

    ⛔ Never a working-tree read: `~/dev/deepseek-harness` can be checked out
    to anything, and the register must resolve the same way regardless. A
    missing branch, an unreadable repo, or a syntax error in the register is a
    refusal — this launcher cannot choose a model without it, and guessing a
    profile would be worse than refusing.
    """
    global _REGISTER_CACHE
    if _REGISTER_CACHE is not None:
        return _REGISTER_CACHE
    ref = f"{REGISTER_BRANCH}:{REGISTER_PATH_IN_REPO}"
    proc = subprocess.run(["git", "-C", str(REGISTER_REPO), "show", ref],
                          capture_output=True, text=True)
    if proc.returncode != 0:
        die(f"cannot read the model register ({ref}) from {REGISTER_REPO}: "
            f"{proc.stderr.strip()}. Without it this launcher cannot choose "
            "a model — nothing was started.", RC_FAIL)
    namespace: dict = {}
    try:
        exec(compile(proc.stdout, ref, "exec"), namespace)
    except Exception as exc:
        die(f"the model register at {ref} failed to load: {exc}. Nothing "
            "was started.", RC_FAIL)
    for required in ("PROFILES", "DEFAULT_PROFILE", "KNOWN_GOOD_PROFILE"):
        if required not in namespace:
            die(f"the model register at {ref} has no {required} — it is "
                "not a valid register. Nothing was started.", RC_FAIL)
    _REGISTER_CACHE = namespace
    return namespace


def resolve_profile(name: str | None) -> tuple[str, dict]:
    """The (name, profile) pair to launch: `name`, or the register's
    `DEFAULT_PROFILE` when omitted — never a caller-side default, so AS3's
    argument-free launch line keeps deferring to whatever this box's operator
    last set as default.

    Refuses loudly, before anything touches ARM or the GPU, on a name the
    register does not have — never a silent fallback to known-good, which
    would run a caller against weights it did not choose.
    """
    register = load_register()
    resolved = name or register["DEFAULT_PROFILE"]
    profiles = register["PROFILES"]
    if resolved not in profiles:
        die(f"unknown model profile {resolved!r}. Known profiles: "
            f"{', '.join(sorted(profiles))}. Nothing was started.", RC_FAIL)
    return resolved, profiles[resolved]


def vllm_args(profile: dict, port: int, uds: str | None = None) -> list[str]:
    """The verified serving command for `profile` (a register entry: `path`,
    `max_model_len`, `kv_cache_memory_bytes`). The non-obvious flags are
    documented in the `qwen38-27b-nvfp4-single-5090` memory; do not drift them
    casually.

    With `uds`, vLLM serves on a Unix socket and `--host`/`--port` are ignored by
    it entirely; the TCP port then belongs to this launcher's proxy instead.
    """
    address = ["--uds", uds] if uds else ["--host", HOST, "--port", str(port)]
    return [
        "serve", str(profile["path"]),
        *address,
        "--served-model-name", profile["served_model_name"],
        "--max-model-len", str(profile["max_model_len"]),
        "--language-model-only",
        "--kv-cache-memory-bytes", str(profile["kv_cache_memory_bytes"]),
        "--max-num-seqs", "16",
        "--linear-backend", "cutlass",
        "--attention-backend", "TRITON_ATTN",
        "--reasoning-parser", "qwen3",
        "--enable-auto-tool-choice",
        "--tool-call-parser", "qwen3_xml",
    ]


