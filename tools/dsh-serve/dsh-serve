_LAST_SAY = ""
_VERB_BEGAN = time.monotonic()


def say(message: str) -> None:
    """Prose for a human, on stderr. Never a contract: `--json` on stdout is the
    machine-readable surface, and this text is free to be reworded."""
    global _LAST_SAY
    _LAST_SAY = message
    print(f"dsh-serve: {message}", file=sys.stderr, flush=True)


def die(message: str, rc: int) -> None:
    say(message)
    sys.exit(rc)


def find_nvidia_smi() -> str | None:
    """PATH first, then WSL's own directory, which `sshd` and non-interactive
    shells do not inject. Returns None for "cannot read", never for "idle"."""
    found = shutil.which("nvidia-smi")
    if found:
        return found
    wsl = "/usr/lib/wsl/lib/nvidia-smi"
    return wsl if os.access(wsl, os.X_OK) else None


def read_gpu_used_mib(timeout_s: float = SMI_TIMEOUT_S) -> int | None:
    """Device-wide VRAM in use, or None if it cannot be read.

    None is UNKNOWN. No caller may read it as zero: per-process attribution is
    blind under WSL2, so this figure is the only GPU truth available here.

    The default timeout is the one the teardown paths need: there, waiting out a
    slow `nvidia-smi` is correct, because the answer is the safety guarantee and
    a lease is being held on it either way. Read-only verbs must NOT wait that
    long — they use `read_gpu_used_mib_quick`.
    """
    smi = find_nvidia_smi()
    if smi is None:
        return None
    try:
        out = subprocess.run(
            [smi, "--query-gpu=memory.used", "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=timeout_s,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    first = out.stdout.strip().splitlines()
    try:
        return int(first[0].strip())
    except (IndexError, ValueError):
        return None


_UNREAD = object()
_QUICK_SMI: int | None | object = _UNREAD


def read_gpu_used_mib_quick() -> int | None:
    """The reading for `status` and `--json`: bounded short, and taken ONCE.

    `nvidia-smi` stalls on this box — a `status` printed `unreadable` under load
    on 2026-08-27, and `status --json` read the card twice, so a stalled binary
    could wedge a read-only verb for 40 s before it said anything. A consumer in
    an unexpected environment then has nothing to classify, which is the failure
    §4c of the consumed-surface doc exists to forbid: an answer this launcher
    cannot get is a fast, typed `null`, never a wedge.

    Memoised for the process, which is exactly one verb: the two call sites also
    stop disagreeing by a few MiB inside one payload.
    """
    global _QUICK_SMI
    if _QUICK_SMI is _UNREAD:
        _QUICK_SMI = bounded_gpu_read(SMI_QUICK_TIMEOUT_S)
    return _QUICK_SMI


def bounded_gpu_read(deadline_s: float) -> int | None:
    """`read_gpu_used_mib` with a deadline that actually holds.

    ⛔ `subprocess.run(timeout=N)` does NOT bound the call. Its timeout bounds
    the WAIT; on expiry CPython does `process.kill()` and then an unbounded
    `process.wait()`, so a child sitting in an uninterruptible kernel call has a
    SIGKILL merely pending and the "timeout" runs as long as the driver takes.
    Measured on this box 2026-08-27: a 3-second cap returned None after 11.5 s,
    and a `status --json` built on it took 31.6 s.

    A daemon thread makes the join the real bound. The stuck child stays stuck —
    nothing in userspace can fix that — but the verb answers on time and the
    thread dies with the interpreter.
    """
    answer: list[int | None] = []
    worker = threading.Thread(
        target=lambda: answer.append(read_gpu_used_mib(deadline_s)),
        daemon=True)
    worker.start()
    worker.join(deadline_s)
    return answer[0] if answer else None


def attention_kv_bytes_per_token(model_path: Path) -> int | None:
    """A lower bound on KV bytes per token, from `model_path`'s own config, or
    None when it cannot be derived.

    ⛔ Takes `model_path` as a value, never a global: this is the profile
    whose window/pool pair is being checked, and reading a module-level
    constant instead would let a partial parameterization check the WRONG
    checkpoint's geometry against a different profile's pool — silently,
    since both are plausible numbers (TD, 2026-08-31).

    Counts attention KV only — full-attention layers x KV heads x head_dim x
    (K + V) x the narrowest KV dtype. The engine needs strictly more than this
    (linear-attention state is carved from the same pool), which is what makes
    it safe to refuse on: every term is a real requirement, so nothing this
    rejects could have served the window.
    """
    try:
        with open(model_path / "config.json") as handle:
            config = json.load(handle)
    except (OSError, ValueError):
        return None
    # Multimodal checkpoints nest the language model's geometry; this one is
    # served `--language-model-only`, and its own config is flat.
    text = config.get("text_config") or config
    types = text.get("layer_types")
    if isinstance(types, list) and types:
        full = sum(1 for one in types if one == "full_attention")
    else:
        layers, interval = text.get("num_hidden_layers"), text.get("full_attention_interval")
        if not isinstance(layers, int) or not isinstance(interval, int) or interval < 1:
            return None
        full = layers // interval
    heads, head_dim = text.get("num_key_value_heads"), text.get("head_dim")
    if not all(isinstance(one, int) and one > 0 for one in (full, heads, head_dim)):
        return None
    return full * heads * head_dim * 2 * KV_DTYPE_BYTES_FLOOR


def last_flag_value(argv: list[str], flag: str) -> str | None:
    """The winning value for `flag`, matching how the parser downstream reads a
    repeated flag: operator overrides are appended after the defaults."""
    value = None
    for index, one in enumerate(argv):
        if one == flag and index + 1 < len(argv):
            value = argv[index + 1]
        elif one.startswith(f"{flag}="):
            value = one.split("=", 1)[1]
    return value


def check_kv_pool_fits_window(serve_args: list[str]) -> str | None:
    """Why the pinned KV pool cannot hold one max-length request, or None.

    Pinning `--kv-cache-memory-bytes` makes vLLM skip memory profiling, so the
    pool never grows to meet `--max-model-len`. Raising the window alone is
    therefore not a tight fit but a `ValueError` out of engine init — roughly a
    minute in, weights already loaded, GPU already claimed. This asks the same
    question as a division, before the claim.

    Checked against the composed command rather than a profile value, so an
    operator's trailing override is covered too — which is when the two are
    most likely to drift apart. The model path is read the same way, from
    `serve_args[1]` (`vllm_args` always emits `["serve", path, ...]`), so this
    checks the SAME checkpoint whose window/pool it is checking — never a
    stale global left over from a previous profile.
    """
    window = last_flag_value(serve_args, "--max-model-len")
    pool = last_flag_value(serve_args, "--kv-cache-memory-bytes")
    if window is None or pool is None:
        return None            # unpinned: vLLM profiles and sizes it itself
    try:
        window_tokens, pool_bytes = int(window), int(pool)
    except ValueError:
        return None            # vLLM owns rejecting malformed values
    if window_tokens < 0:
        return None            # -1 is auto-fit; vLLM picks the window
    model_path = Path(serve_args[1]) if len(serve_args) > 1 and serve_args[0] == "serve" else None
    per_token = attention_kv_bytes_per_token(model_path) if model_path else None
    if per_token is None:
        say(f"WARNING: cannot read the KV geometry from {model_path}/config.json, "
            "so the pool/window check is unavailable; vLLM remains the authority")
        return None
    needed = window_tokens * per_token
    if needed <= pool_bytes:
        return None
    return (
        f"--kv-cache-memory-bytes {pool_bytes} ({pool_bytes / 2**30:.2f} GiB) cannot "
        f"hold one {window_tokens}-token request: attention KV alone needs "
        f"{needed} bytes ({needed / 2**30:.2f} GiB) at {per_token} bytes/token, and "
        f"linear-attention state comes out of the same pool on top of that. "
        f"`--kv-cache-memory-bytes` skips vLLM's memory profiling, so the pool does "
        f"not grow to meet the window — raise it above {needed}, or lower "
        f"--max-model-len. Refusing before claiming {POOL}; vLLM would raise this "
        "about a minute into startup with the card already taken.")


def settings_path() -> Path:
    return Path.home() / ".dsh" / "settings.yaml"


def check_settings_context_window(max_model_len: int, served_model_name: str) -> str | None:
    """Why `~/.dsh/settings.yaml`'s `contextWindow` disagrees with the
    profile about to be served, or None.

    The harness sizes compaction from `contextWindow` (dsh-local-llm-wiring
    memory); a smaller server window than the harness believes it has turns a
    chat overflow into a hard mid-turn failure instead of a proactive
    compaction. Nothing else validates this pairing — a per-profile window
    makes it a per-profile invariant, checked here, before claiming the GPU,
    same failure class as `check_kv_pool_fits_window`.

    Matched by `served_model_name`, not a fixed constant: each profile has
    its own id (`models.py`, `served_model_name`) and its own window, so a
    settings.yaml with entries for both profiles is checked against the ONE
    entry that names the profile actually being launched — never a stale
    global that would check the wrong profile's window against this one's id.

    Degrades to a WARNING, never a refusal, when settings.yaml or its
    `contextWindow` cannot be read: an unreadable INPUT to a check is not
    evidence of a mismatch, and a first-ever boot on a fresh box has no
    settings.yaml yet.
    """
    path = settings_path()
    try:
        text = path.read_text()
    except OSError:
        say(f"WARNING: cannot read {path}, so the contextWindow / "
            "--max-model-len pairing is unchecked")
        return None
    match = re.search(
        r"-\s+id:\s*" + re.escape(served_model_name) + r"\b.*?contextWindow:\s*(\d+)",
        text, re.DOTALL)
    if match is None:
        say(f"WARNING: no contextWindow found for model id {served_model_name!r} "
            f"in {path}, so the pairing is unchecked")
        return None
    declared = int(match.group(1))
    if declared == max_model_len:
        return None
    return (
        f"{path} declares contextWindow {declared} for {served_model_name!r}, "
        f"but this launch uses --max-model-len {max_model_len}. The harness "
        f"sizes compaction from contextWindow, so a mismatch turns a chat "
        f"overflow into a hard mid-turn failure instead of a proactive "
        f"compaction. Edit {path}'s contextWindow to {max_model_len} and "
        f"retry. Refusing before claiming {POOL}.")


def pgid_members(pgid: int) -> list[int]:
    """Every live process in `pgid`, read from /proc.

    Identity comes from the recorded group id alone. Nothing here matches on a
    name or a command line, so this can never reach a process we did not start.
    """
    found = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            with open(f"/proc/{entry}/stat", "rb") as handle:
                fields = handle.read().rsplit(b")", 1)[1].split()
        except OSError:
            continue  # exited between listdir and open
        if len(fields) > 2 and int(fields[2]) == pgid and fields[0] != b"Z":
            found.append(int(entry))
    return found


def proc_stat(pid: int) -> list[bytes] | None:
    """`/proc/<pid>/stat` from the field after `comm`, or None if it is gone.

    Split on the LAST `)` because `comm` is unquoted and may contain one.
    """
    try:
        with open(f"/proc/{pid}/stat", "rb") as handle:
            return handle.read().rsplit(b")", 1)[1].split()
    except OSError:
        return None


def pid_start_ticks(pid: int) -> int | None:
    """The PID's start time, which makes a recorded PID unambiguous.

    PIDs are recycled. Recording this alongside one turns "is my process still
    there" into a question that cannot accidentally answer yes about a stranger
    — the discipline ARM applies to its own leases.
    """
    fields = proc_stat(pid)
    return int(fields[19]) if fields and len(fields) > 19 else None


def pid_elapsed_seconds(pid: int | None) -> float | None:
    """How long the PID has been alive, measured on the boot clock.

    Reported next to the wall-clock `started_at` because the two disagree on
    this box and a reader reconciling a timeline cannot tell which one moved.
    WSL2 syncs its clock to the Windows host (`hv_utils.timesync_implicit=1`
    on the kernel command line); a forward step leaves every record written
    before it — log lines, file mtimes, `started_at` — where it was, and moves
    the start time `ps lstart` and `etimes` derive for every process that was
    already running. Measured 2026-08-25: a server whose own first log line
    reads 15:42:07 had `ps lstart` reporting 15:44:32.
    """
    ticks = pid_start_ticks(pid) if pid else None
    if ticks is None:
        return None
    try:
        with open("/proc/uptime") as handle:
            uptime = float(handle.read().split()[0])
    except (OSError, ValueError, IndexError):
        return None
    return uptime - ticks / os.sysconf("SC_CLK_TCK")


def format_duration(seconds: float | None) -> str:
    if seconds is None or seconds < 0:
        return "unknown"
    minutes, secs = divmod(int(seconds), 60)
    hours, minutes = divmod(minutes, 60)
    if hours:
        return f"{hours}h{minutes:02d}m"
    return f"{minutes}m{secs:02d}s" if minutes else f"{secs}s"


def pid_alive(pid: int | None, start_ticks: int | None = None) -> bool:
    """Live, and — when `start_ticks` is recorded — still the same process.

    A zombie is NOT alive: it has exited and released everything it held, and
    only its exit status is still on the books. Answering yes for one would
    make `stop` wait out its full timeout against a process that is already
    done, and report the card held when it is free.
    """
    if pid is None or pid < 1:
        return False
    fields = proc_stat(pid)
    if fields is None or fields[0] == b"Z":
        return False
    if start_ticks is None:
        return True
    return pid_start_ticks(pid) == start_ticks


def write_state(payload: dict) -> None:
    """Atomic, so a reader never sees a half-written record."""
    state_dir().mkdir(parents=True, exist_ok=True)
    handle, tmp = tempfile.mkstemp(dir=state_dir(), prefix=".state-")
    with os.fdopen(handle, "w") as out:
        json.dump(payload, out, indent=2)
        out.write("\n")
    os.replace(tmp, state_path())


def read_state() -> dict | None:
    try:
        with open(state_path()) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


_START_LOCK = None


def take_start_lock():
    """An exclusive, non-blocking lock held for the whole `start` verb.

    Returns the open descriptor, or None if another `start` holds it. Kept in a
    module global as well: the lock lives as long as the descriptor, and a local
    that fell out of scope would release it mid-start.
    """
    global _START_LOCK
    if _START_LOCK is not None:
        # `try-vision` starts twice in one process — the attempt, then the
        # restore. flock is per open file description, so a second `open()`
        # here would deadlock this process against itself; one invocation is
        # one caller and already holds the lock it needs.
        return _START_LOCK
    state_dir().mkdir(parents=True, exist_ok=True)
    handle = os.open(lock_path(), os.O_CREAT | os.O_RDWR, 0o644)
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(handle)
        return None
    os.ftruncate(handle, 0)
    os.write(handle, f"{os.getpid()}\n".encode())
    _START_LOCK = handle
    return handle


def accept_running(live: dict, serve_args: list[str]) -> int:
    """`--if-not-running` against a server that is already up.

    Success ONLY when the running configuration is the one asked for. A server
    serving something else is a failure with a name, not a hit: silently
    accepting it would hand the caller a model, a window or a modality it did
    not ask for and report success.
    """
    if state_phase(live) != "serving":
        die("a start is already in flight; it has not answered /health yet. "
            "Wait for it and read `dsh-serve status`.", RC_ALREADY_RUNNING)
    recorded = live.get("serve_args")
    if recorded is None:
        die("already running, but its record predates configuration recording "
            "(pre-2026-08-27), so this cannot verify it is the configuration "
            "you asked for. Restart it, or drop --if-not-running to accept "
            "whatever is up.", RC_CONFIG_MISMATCH)
    if list(recorded) != list(serve_args):
        # Named first because it is the difference that changes what the server
        # can DO: a text-only server answers a captioning request successfully
        # and describes nothing.
        eyes = vision_requested(recorded), vision_requested(serve_args)
        if eyes[0] != eyes[1]:
            die(f"already running, but the VISION STATE differs: running with "
                f"the tower {'ON' if eyes[0] else 'OFF'}, requested "
                f"{'ON' if eyes[1] else 'OFF'}. `dsh-serve try-vision` is the "
                "verb that turns the eyes on and proves them.",
                RC_CONFIG_MISMATCH)
        die(f"already running, but NOT as requested. Running: {recorded}. "
            f"Requested: {serve_args}. `dsh-serve stop` first if you need the "
            "requested configuration.", RC_CONFIG_MISMATCH)
    served = last_flag_value(serve_args, "--served-model-name")
    say(f"already running as requested: {served} on "
        f"http://{HOST}:{live.get('port', PORT)}, vllm pid "
        f"{live.get('vllm_pid')}; nothing started")
    return RC_OK


def state_phase(live: dict | None) -> str:
    """`starting` from the moment `start` spawns the wrapper; `serving` once the
    supervisor has the server.

    Records written before 2026-08-27 carry no phase and are always `serving` —
    only a supervisor wrote a record then, and only after its `Popen`. Reading a
    missing phase as `starting` would make `stop` chase a wrapper that is not
    coming.
    """
    return (live or {}).get("phase", "serving")


def vision_requested(serve_args: list[str] | None) -> bool | None:
    """Whether these arguments ASK for the vision tower, by the last modality
    flag — vLLM takes the last occurrence, and `try-vision` appends its negation
    to the shipped list rather than rewriting it.

    None when the record predates configuration recording, which is not the same
    as False. Asking is not proof: see `vision_state`.
    """
    if not serve_args:
        return None
    seen = [one for one in serve_args
            if one in ("--language-model-only", "--no-language-model-only")]
    return seen[-1] == "--no-language-model-only" if seen else False


def vision_state(live: dict | None) -> bool | None:
    """Whether this server can be sent an image. Three values, three meanings.

    `True` only once a real image round-tripped through it — `try-vision`'s own
    proof, recorded on the way past. `False` only when the launcher itself
    passed `--language-model-only`, which zeroes every modality limit, so an
    image comes back `At most 0 image(s) may be provided in one prompt`; that is
    knowable without checking. `None` is unknown — the record predates this
    field, or the arguments ask for the tower and nothing has proved it yet.

    ⛔ Never `False` for "we did not look". A consumer that gates captioning on
    this must be able to read `False` as a refusal and `None` as a question.
    """
    if not live:
        return None
    if live.get("vision_proven"):
        return True
    return False if vision_requested(live.get("serve_args")) is False else None


def mark_vision_proven(port: int) -> None:
    """Record that an image round-tripped, so a later reader does not have to
    re-prove it. Only ever called after `image_probe` passed."""
    live = read_state()
    if live:
        write_state({**live, "vision_proven": True,
                     "vision_proven_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                     "vision_proven_port": port})


def served_model_id(port: int) -> str | None:
    """The id the SERVER reports, which is the only evidence of what is loaded.
    The state file's `model` is what this launcher asked for."""
    try:
        with urllib.request.urlopen(
                f"http://{HOST}:{port}/v1/models", timeout=3) as response:
            data = json.load(response).get("data") or []
        return data[0].get("id") if data else None
    except (urllib.error.URLError, OSError, ValueError, KeyError, IndexError,
            http.client.HTTPException):
        return None


def json_payload(rc: int) -> dict:
    """The machine-readable answer, identical for every verb.

    `model` is queried from the server and `model_requested` comes from the
    state file: a caller comparing its own expected id against `model` is
    comparing against evidence. `message` is the last line of prose and is for
    display only — parsing it is the mistake `--json` exists to remove.

    `profile` (additive, 2026-08-31) is the register profile name this
    launcher resolved and started. Each profile has its own
    `served_model_name` (2026-09-04), so `model_served`/`model_requested`
    now say WHICH weights answered too — but `profile` is still the field to
    read: it names the register entry directly, rather than requiring a
    consumer to reverse a served id back into a profile name if the register
    ever changes what id a profile serves.
    """
    live = read_state() or {}
    port = live_port(live if live else None)
    healthy = server_ready_once(port)
    used = read_gpu_used_mib_quick()
    return {
        "schema_version": JSON_SCHEMA_VERSION,
        "rc": rc,
        "running": bool(live) and (
            pid_alive(live.get("supervisor_pid"),
                      live.get("supervisor_start_ticks"))
            or pid_alive(live.get("wrapper_pid"),
                         live.get("wrapper_start_ticks"))),
        "phase": state_phase(live) if live else None,
        "healthy": healthy,
        "model_served": served_model_id(port) if healthy else None,
        "model_requested": live.get("model"),
        "profile": live.get("profile"),
        "vision": vision_state(live),
        "vision_requested": vision_requested(live.get("serve_args")),
        "endpoint": f"http://{HOST}:{port}",
        "port": port,
        "arbitrated": live.get("arbitrated"),
        "serving_since": live.get("started_at"),
        "up_seconds": pid_elapsed_seconds(live.get("vllm_pid")),
        "supervisor_pid": live.get("supervisor_pid"),
        "vllm_pid": live.get("vllm_pid"),
        "proxy_pid": live.get("proxy_pid"),
        "vram_used_mib": used,
        "vram_baseline_mib": live.get("vram_baseline_mib"),
        # Additive, and it exists because diagnosing a slow call otherwise takes
        # a person with a stopwatch: `nvidia-smi` on this box costs seconds on
        # its first call after an idle period and ~0.1 s warm, so a consumer
        # that logs this can tell "the box was cold" from "the launcher is
        # broken" without re-running anything.
        "elapsed_seconds": round(time.monotonic() - _VERB_BEGAN, 3),
        "message": _LAST_SAY,
    }


def port_in_use(port: int) -> bool:
    with socket.socket() as probe:
        probe.settimeout(1.0)
        return probe.connect_ex((HOST, port)) == 0


_HEALTH: dict[int, bool] = {}


def server_ready_once(port: int) -> bool:
    """`server_ready` for the read-only verbs: asked once per process.

    `status --json` probed health twice — in the prose and again in the payload
    — for the same reason it read the card twice. One verb is one snapshot, and
    two answers inside one output could disagree.
    """
    if port not in _HEALTH:
        _HEALTH[port] = server_ready(port)
    return _HEALTH[port]


def server_ready(port: int) -> bool:
    try:
        with urllib.request.urlopen(f"http://{HOST}:{port}/health", timeout=3) as response:
            return response.status == 200
    # While the proxy is up but vLLM is not, the proxy accepts and closes at
    # once rather than hanging, which surfaces here as a protocol-level
    # disconnect rather than a socket error.
    except (urllib.error.URLError, OSError, ValueError,
            http.client.HTTPException):
        return False


def arm_available() -> bool:
    """Runnable, not merely present on PATH."""
    found = shutil.which("arm")
    if found is None:
        return False
    try:
        return subprocess.run([found, "--help"], capture_output=True,
                              timeout=30).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def describe_blockers() -> str:
    """Name who is in the way, from `blockers_detail` values — never by parsing
    `reason`, whose wording is not a contract (consumer brief §3)."""
    try:
        out = subprocess.run(["arm", "check", POOL, "--exclusive", "--json"],
                             capture_output=True, text=True, timeout=30)
        payload = json.loads(out.stdout)
        # Both `check` and `claim` nest the decision under `decision`, at the
        # same depth and with the same keys (verified 2026-08-24); `claim` adds
        # a top-level `lease`, which is the only structural difference. A
        # top-level read of `blockers_detail` finds nothing from either.
        detail = (payload.get("decision") or {}).get("blockers_detail") or []
    except (OSError, subprocess.SubprocessError, ValueError, AttributeError):
        return ""
    parts = []
    for one in detail:
        who = one.get("app", "?")
        why = one.get("purpose") or "no purpose recorded"
        # `waiter` means the pool may be entirely free and we are standing aside
        # for a queued higher-priority claim; "held by" would be a lie.
        verb = "held by" if one.get("kind") == "lease" else "queued behind"
        parts.append(f"{verb} {who} ({why})")
    return "; ".join(parts)


# --------------------------------------------------------------------------
# evidence trap — what to grab when the server is up but nobody can reach it
# --------------------------------------------------------------------------
#
# Twice on 2026-08-25 (and once on 2026-08-24) vLLM finished startup cleanly —
# weights loaded, CUDA graphs captured, `Application startup complete`, the
# listener present on the right pid — and every connect to 127.0.0.1 timed out.
# The client sat in SYN-SENT while the listener's accept queue stayed at
# `Recv-Q 0`, so the SYN never reached the socket: below the application layer,
# because a process that had merely stopped calling accept() would show
# `Recv-Q > 0`.
#
# The mechanism is UNIDENTIFIED and this file does not guess at one. The point
# of this capture is that the next bite opens a root-cause task with data
# instead of a symptom, so it runs BEFORE any restore throws the state away.
#
# The diagnostic core is the kernel counter delta around a deliberate connect:
# /proc/net/snmp and /proc/net/netstat carry TcpExt.ListenDrops,
# ListenOverflows, TCPReqQFullDrop, Tcp.AttemptFails and friends. Which of them
# moves — or that none of them moves — is the one cheap fact that narrows where
# the SYN dies. Everything else here is context around that.

EVIDENCE_KEEP = 20


def evidence_dir() -> Path:
    return state_dir() / "unreachable"


def run_text(command: list[str], timeout: float = 15.0) -> str:
    """Best-effort command output for the capture. A missing tool is recorded as
    a missing tool: an absent section must never read as an empty result."""
    try:
        out = subprocess.run(command, capture_output=True, text=True,
                             timeout=timeout)
    except FileNotFoundError:
        return f"({command[0]} not on PATH)"
    except (OSError, subprocess.SubprocessError) as exc:
        return f"({command[0]} failed: {type(exc).__name__}: {exc})"
    body = (out.stdout or "") + (out.stderr or "")
    return body.strip() or f"(no output, rc={out.returncode})"


def proc_net_counters() -> dict[str, int]:
    """Flatten /proc/net/snmp and /proc/net/netstat into `Prefix.Key -> int`.

    Both files are pairs of lines: a header naming the columns, then the values,
    each prefixed by the same protocol tag. Rows whose tags disagree are skipped
    rather than zipped into nonsense.
    """
    counters: dict[str, int] = {}
    for path in ("/proc/net/snmp", "/proc/net/netstat"):
        try:
            lines = Path(path).read_text().splitlines()
        except OSError:
            continue
        for header, values in zip(lines[::2], lines[1::2]):
            head, data = header.split(), values.split()
            if not head or not data or head[0] != data[0]:
                continue
            prefix = head[0].rstrip(":")
            for key, value in zip(head[1:], data[1:]):
                try:
                    counters[f"{prefix}.{key}"] = int(value)
                except ValueError:
                    pass
    return counters


def connect_attempt(port: int, timeout: float = 5.0) -> str:
    """One deliberate connect, described. This is the event the counter delta is
    measured around, so it happens even though it is expected to fail."""
    started = time.monotonic()
    with socket.socket() as probe:
        probe.settimeout(timeout)
        try:
            probe.connect((HOST, port))
        except (TimeoutError, socket.timeout):
            return f"TIMED OUT after {time.monotonic() - started:.1f}s"
        except OSError as exc:
            return (f"failed after {time.monotonic() - started:.1f}s: "
                    f"errno {exc.errno} ({exc.strerror})")
    return f"CONNECTED in {time.monotonic() - started:.1f}s"


def prune_evidence(keep: int = EVIDENCE_KEEP) -> None:
    """Bounded by count, and only over files this launcher itself named — the
    glob is anchored to our own prefix so nothing else can be swept up."""
    try:
        captures = sorted(evidence_dir().glob("unreachable-*.txt"))
    except OSError:
        return
    for stale in captures[:-keep] if len(captures) > keep else []:
        try:
            stale.unlink()
        except OSError:
            pass


def capture_unreachable_evidence(port: int, note: str) -> Path | None:
    """Record why the port did not answer, before anything is torn down.

    Returns the capture's path, or None if it could not be written — a failure
    to capture must not stop the caller from restoring service.
    """
    stamp = time.strftime("%Y%m%dT%H%M%S%z")
    live = read_state() or {}
    vllm_pid = live.get("vllm_pid")

    before = proc_net_counters()
    attempt = connect_attempt(port)
    # Sampled while the SYN-SENT socket from the attempt above may still exist:
    # the client side is half the signature and it disappears within seconds.
    sockets_during = run_text(["ss", "-tanp", "-o"])
    after = proc_net_counters()
    moved = {key: (before[key], value) for key, value in after.items()
             if key in before and before[key] != value}

    sections: list[tuple[str, str]] = [
        ("note", note),
        ("when", f"{stamp} (port {port}, host {HOST})"),
        ("state", json.dumps(live, indent=2) if live else "(no state file)"),
        ("connect attempt", attempt),
        ("kernel counter DELTA across the attempt",
         "\n".join(f"{key}: {old} -> {new}  (+{new - old})"
                   for key, (old, new) in sorted(moved.items()))
         or "(no counter moved — the SYN left no trace in snmp/netstat)"),
        ("listener for this port", run_text(["ss", "-ltnp", f"sport = :{port}"])),
        ("all tcp sockets + timers (sampled during the attempt)", sockets_during),
        ("socket summary", run_text(["ss", "-s"])),
        # The raw table is the fallback for a box where `ss` is missing, and it
        # is also the only place the listener's queue depths appear as hex.
        ("/proc/net/tcp (raw)", run_text(
            ["sh", "-c", f"grep -i ':{port:04X}' /proc/net/tcp || true"])),
        ("listening process", run_text(
            ["sh", "-c", f"cat /proc/{vllm_pid}/status 2>/dev/null "
                         "| head -20 || true"]) if vllm_pid else "(no vllm pid)"),
        ("tcp sysctls", run_text(
            ["sh", "-c", "sysctl net.ipv4.tcp_syncookies net.core.somaxconn "
                         "net.ipv4.tcp_max_syn_backlog "
                         "net.ipv4.tcp_abort_on_overflow 2>/dev/null || true"])),
        ("interfaces", run_text(["ip", "-brief", "addr"])),
        ("vram", run_text(["sh", "-c",
                           "nvidia-smi --query-gpu=memory.used,memory.total "
                           "--format=csv,noheader 2>/dev/null || true"])),
        ("server log tail", run_text(
            ["sh", "-c", f"tail -40 {log_path()} 2>/dev/null || true"])),
    ]

    body = f"# dsh-serve unreachable capture {stamp}\n"
    for title, content in sections:
        body += f"\n===== {title} =====\n{content}\n"

    try:
        evidence_dir().mkdir(parents=True, exist_ok=True)
        path = evidence_dir() / f"unreachable-{stamp}.txt"
        path.write_text(body)
    except OSError as exc:
        say(f"could not write the unreachable capture: {exc}")
        return None
    prune_evidence()
    say(f"captured unreachable evidence -> {path}")
    if moved:
        say("kernel counters that moved across a connect attempt: "
            + ", ".join(f"{key} +{new - old}"
                        for key, (old, new) in sorted(moved.items())))
    else:
        say("no kernel counter moved across the connect attempt")
    return path


# --------------------------------------------------------------------------
# the TCP -> Unix-socket proxy, and why it exists
# --------------------------------------------------------------------------
#
# vLLM `bind()`s its TCP port at process start and only `listen()`s inside
# uvicorn, after the whole engine build (`create_server_socket` — a deliberate
# workaround for vllm#8204). On this box, every start whose bind->listen gap
# exceeded ~100 s came up with a live listener that never received a SYN, and
# every start under ~70 s was fine: 12 for 12, including one TEXT-ONLY failure
# at 264 s, which is what rules vision out as the variable.
#
# ⚠️ That gap is the CORRELATE, not the mechanism. A synthetic socket bound for
# 150 s and then listened on connects instantly, as does one whose bound fd is
# held by a live forked child — so a long gap ALONE does not cause this, and
# what breaks during a long vLLM start specifically is still unknown. Upstream
# knows the symptom (vllm#31124, open) and `main` still binds without listening,
# so there is no version to upgrade to.
#
# This proxy is right precisely BECAUSE it does not need the mechanism: vLLM
# serves on a Unix socket, which has no SYN, no loopback TCP and no WSL
# mirrored-networking layer, so the failure cannot arise there at all. The TCP
# port consumers use is held by this proxy, which binds AND listens in the same
# breath — the regime that has never failed.
#
# ⛔ Consumers must not be able to tell. `~/.dsh/settings.yaml` and the fleet
# chat backend both name `http://127.0.0.1:8001/v1` and neither is touched.

PROXY_CHUNK = 65536
PROXY_UPSTREAM_CONNECT_S = 5.0
PROXY_BACKLOG = 2048
PROXY_BIND_TIMEOUT_S = 15.0    # a fresh interpreter parsing this file, no more
PROXY_REQUEST_TIMEOUT_S = 60.0  # head + body from a live loopback client; an idle or half-open one dies here
PROXY_SHADOW_MAX_ACTIVE = 2
PROXY_MAX_QUEUED = 64
PROXY_MAX_QUEUED_PER_TENANT = 8
PROXY_MAX_REQUEST_BODY_BYTES = 64 * 1024 * 1024
PROXY_MAX_QUEUED_BODY_BYTES = 64 * 1024 * 1024
PROXY_PERMIT_TTL_S = 5.0
PROXY_QUEUE_DEADLINES_MS = {
    "control": 30_000,
    "interactive": 120_000,
    "agent": 240_000,
    "background": 600_000,
}
PROXY_WORK_CLASSES = ("control", "interactive", "agent", "background")
PROXY_CLASS_WEIGHTS = {
    "control": 16, "interactive": 8, "agent": 4, "background": 1,
}
PROXY_BACKGROUND_AGE_MS = 120_000
PROXY_AGENT_AGE_MS = 60_000
PROXY_METADATA_MAX_CHARS = 128
PROXY_SCHEDULING_HEADERS = {
    "x-aivan-work-class", "x-aivan-tenant", "x-aivan-purpose",
    "x-aivan-request-id", "x-aivan-queue-deadline-ms",
    "x-aivan-admission",
}
# The auto-mode permission classifier, by the unique first line of the system
# prompt the harness gives it. Other harness blocks may precede that prompt in
# the request. Its verdict must land inside the client's ~61 s
# deadline, so the proxy turns thinking off for it (see
# `rewrite_thinking_off`) — the only traffic that loses reasoning at the relay.
PROXY_CLASSIFIER_PREFIX = (
    "You are a security monitor for autonomous AI coding agents")


def uds_path() -> Path:
    return state_dir() / "vllm.sock"


def uds_in_use(path: Path) -> bool:
    """True if something is actually accepting on this socket file."""
    if not path.exists():
        return False
    probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    probe.settimeout(2.0)
    try:
        probe.connect(str(path))
        return True
    except OSError:
        return False
    finally:
        probe.close()


def prepare_uds(path: Path) -> str | None:
    """Clear a stale socket file, or refuse if it is live. Returns an error."""
    if uds_in_use(path):
        return (f"{path} is already being served. Something outside this "
                "launcher holds it — leave it alone, or stop it the way it was "
                "started.")
    try:
        path.unlink()
    except FileNotFoundError:
        pass
    except OSError as exc:
        return f"cannot clear the stale socket {path}: {exc}"
    return None


def rewrite_thinking_off(path: str, body: bytes) -> tuple[bytes, str | None]:
    """Merge enable_thinking:False into a body that must answer fast.

    Returns (body, reason); reason is None when the body went through
    untouched. The vLLM Anthropic adapter installed here silently drops the
    `thinking` request parameter (no schema field; only chat_template_kwargs
    is forwarded), and the Qwen template thinks by default. So a request
    whose verdict must land inside the client's ~61 s deadline — the
    harness's auto-mode permission classifier — or any client explicitly
    asking for no thinking (`thinking.type == "disabled"`), gets the one knob
    the template honours. Everything else is returned BYTE-IDENTICAL (no
    re-serialisation): normal agent traffic keeps its reasoning, and bodies
    that do not parse pass through rather than break.
    """
    if not path.startswith("/v1/messages"):
        return body, None
    try:
        request = json.loads(body)
    except (UnicodeDecodeError, ValueError):
        return body, None
    if not isinstance(request, dict):
        return body, None

    system = request.get("system")
    if isinstance(system, str):
        system_text = system
    elif isinstance(system, list):
        system_text = "".join(block.get("text", "") for block in system
                              if isinstance(block, dict))
    else:
        system_text = ""
    is_classifier = PROXY_CLASSIFIER_PREFIX in system_text

    thinking = request.get("thinking")
    wants_disabled = (isinstance(thinking, dict)
                      and thinking.get("type") == "disabled")
    if not (is_classifier or wants_disabled):
        return body, None

    kwargs = request.get("chat_template_kwargs")
    if not isinstance(kwargs, dict):
        kwargs = {}
    if wants_disabled and not is_classifier \
            and kwargs.get("enable_thinking") is True:
        # The client drove the knob explicitly against its own thinking
        # field — a contradiction this relay does not get to settle.
        return body, None
    kwargs["enable_thinking"] = False
    request["chat_template_kwargs"] = kwargs
    reason = ("auto-mode classifier request" if is_classifier
              else 'thinking: "disabled"')
    return json.dumps(request, ensure_ascii=False).encode("utf-8"), reason


def header_fields(header_lines: list[str]) -> dict[str, str]:
    """Return lower-case HTTP fields; later duplicates win for audit only."""
    fields = {}
    for line in header_lines:
        key, sep, value = line.partition(":")
        if sep:
            fields[key.strip().lower()] = value.strip()
    return fields


def is_classifier_request(path: str, body: bytes) -> bool:
    """Recognize the existing bounded Claude auto-mode classifier."""
    if not path.startswith("/v1/messages"):
        return False
    try:
        request = json.loads(body)
    except (UnicodeDecodeError, ValueError):
        return False
    if not isinstance(request, dict):
        return False
    system = request.get("system")
    if isinstance(system, str):
        system_text = system
    elif isinstance(system, list):
        system_text = "".join(block.get("text", "") for block in system
                              if isinstance(block, dict))
    else:
        system_text = ""
    return PROXY_CLASSIFIER_PREFIX in system_text


def shadow_metadata(path: str, header_lines: list[str], body: bytes) -> dict:
    """Validate scheduling metadata and classify one inference request.

    This computes Phase 1 policy input only. It neither delays nor rejects the
    request. Unknown or malformed metadata downgrades to the safe legacy agent
    class, and only a bounded tenant digest reaches logs.
    """
    fields = header_fields(header_lines)
    supplied = {name: fields[name] for name in PROXY_SCHEDULING_HEADERS
                if name in fields}
    invalid = any(len(value) > PROXY_METADATA_MAX_CHARS
                  or "\r" in value or "\n" in value
                  for value in supplied.values())
    claimed_class = supplied.get("x-aivan-work-class")
    if claimed_class is not None and claimed_class not in PROXY_WORK_CLASSES:
        invalid = True
    deadline = supplied.get("x-aivan-queue-deadline-ms")
    if deadline is not None:
        try:
            if int(deadline) <= 0:
                invalid = True
        except ValueError:
            invalid = True

    if is_classifier_request(path, body):
        work_class = "control"
        purpose = "permission-classifier"
        source = "classifier"
    elif invalid:
        work_class = "agent"
        purpose = "invalid-metadata"
        source = "downgraded"
    elif claimed_class is not None:
        work_class = claimed_class
        purpose = supplied.get("x-aivan-purpose", "unspecified")
        source = "explicit"
    else:
        work_class = "agent"
        purpose = "unspecified"
        source = "legacy"

    tenant = supplied.get("x-aivan-tenant", "legacy")
    if invalid:
        tenant = "legacy"
    tenant_digest = hashlib.sha256(tenant.encode("utf-8")).hexdigest()[:12]
    return {"class": work_class, "purpose": purpose[:PROXY_METADATA_MAX_CHARS],
            "source": source, "tenant": tenant_digest,
            "tenant_raw": tenant,
            "request_id": supplied.get("x-aivan-request-id"),
            "deadline_ms": (int(deadline) if deadline is not None and not invalid
                            else PROXY_QUEUE_DEADLINES_MS[work_class]),
            "invalid": invalid}


class AdmissionOverload(Exception):
    """A bounded local admission queue refused or expired one request."""

    def __init__(self, code: str, message: str) -> None:
        super().__init__(message)
        self.code = code


class AdmissionController:
    """Bounded two-slot admission with weighted, ageing class selection."""

    def __init__(self) -> None:
        self.condition = asyncio.Condition()
        self.active = 0
        self.active_by_class = {name: 0 for name in PROXY_WORK_CLASSES}
        self.background_by_tenant: dict[str, int] = {}
        self.queued = 0
        self.queued_by_tenant: dict[str, int] = {}
        self.queued_body_bytes = 0
        self.queue: list[dict] = []
        self.sequence = 0
        self.class_current = {name: 0 for name in PROXY_WORK_CLASSES}
        self.last_tenant_by_class: dict[str, str] = {}
        self.permits: dict[str, tuple[dict, asyncio.Task]] = {}

    def _tenant_eligible(self, metadata: dict) -> bool:
        if metadata["class"] != "background":
            return True
        tenant = metadata["tenant_raw"]
        return self.background_by_tenant.get(tenant, 0) < 1

    @staticmethod
    def _effective_class(entry: dict, now: float) -> str:
        work_class = entry["metadata"]["class"]
        waited_ms = (now - entry["enqueued_at"]) * 1000
        if work_class == "background" and waited_ms >= PROXY_BACKGROUND_AGE_MS:
            return "agent"
        if work_class == "agent" and waited_ms >= PROXY_AGENT_AGE_MS:
            return "interactive"
        return work_class

    def _remove_queued(self, entry: dict) -> None:
        self.queue.remove(entry)
        self.queued -= 1
        self.queued_body_bytes -= entry["body_bytes"]
        tenant = entry["metadata"]["tenant_raw"]
        remaining = self.queued_by_tenant.get(tenant, 0) - 1
        if remaining > 0:
            self.queued_by_tenant[tenant] = remaining
        else:
            self.queued_by_tenant.pop(tenant, None)

    def _pick_queued(self) -> dict | None:
        now = time.monotonic()
        eligible = [entry for entry in self.queue
                    if self._tenant_eligible(entry["metadata"])]
        if not eligible:
            return None
        grouped = {name: [] for name in PROXY_WORK_CLASSES}
        for entry in eligible:
            grouped[self._effective_class(entry, now)].append(entry)
        present = [name for name in PROXY_WORK_CLASSES if grouped[name]]
        for name in PROXY_WORK_CLASSES:
            if name in present:
                self.class_current[name] += PROXY_CLASS_WEIGHTS[name]
            else:
                self.class_current[name] = 0
        selected_class = max(
            present, key=lambda name: (self.class_current[name],
                                       -PROXY_WORK_CLASSES.index(name)))
        self.class_current[selected_class] -= sum(
            PROXY_CLASS_WEIGHTS[name] for name in present)
        candidates = sorted(grouped[selected_class], key=lambda item: item["sequence"])
        last_tenant = self.last_tenant_by_class.get(selected_class)
        tenants = {item["metadata"]["tenant_raw"] for item in candidates}
        selected = next((item for item in candidates
                         if len(tenants) > 1
                         and item["metadata"]["tenant_raw"] != last_tenant),
                        candidates[0])
        self.last_tenant_by_class[selected_class] = \
            selected["metadata"]["tenant_raw"]
        return selected

    def _dispatch(self) -> None:
        while self.active < PROXY_SHADOW_MAX_ACTIVE:
            entry = self._pick_queued()
            if entry is None:
                return
            self._remove_queued(entry)
            entry["admitted"] = True
            self._occupy(entry["metadata"])
            waited = (time.monotonic() - entry["enqueued_at"]) * 1000
            if not entry["future"].done():
                entry["future"].set_result(waited)

    def _occupy(self, metadata: dict) -> None:
        self.active += 1
        self.active_by_class[metadata["class"]] += 1
        if metadata["class"] == "background":
            tenant = metadata["tenant_raw"]
            self.background_by_tenant[tenant] = \
                self.background_by_tenant.get(tenant, 0) + 1

    def _release(self, metadata: dict) -> None:
        self.active = max(0, self.active - 1)
        work_class = metadata["class"]
        self.active_by_class[work_class] = max(
            0, self.active_by_class[work_class] - 1)
        if metadata["class"] == "background":
            tenant = metadata["tenant_raw"]
            remaining = self.background_by_tenant.get(tenant, 0) - 1
            if remaining > 0:
                self.background_by_tenant[tenant] = remaining
            else:
                self.background_by_tenant.pop(tenant, None)

    async def enter(self, metadata: dict, body_bytes: int = 0) -> float:
        """Wait for weighted admission, then occupy one active slot."""
        started = time.monotonic()
        tenant = metadata["tenant_raw"]
        timeout = min(metadata["deadline_ms"],
                      PROXY_QUEUE_DEADLINES_MS[metadata["class"]]) / 1000
        entry = None
        async with self.condition:
            if (self.active < PROXY_SHADOW_MAX_ACTIVE and not self.queue
                    and self._tenant_eligible(metadata)):
                self._occupy(metadata)
                return (time.monotonic() - started) * 1000
            else:
                if (self.queued >= PROXY_MAX_QUEUED
                        or self.queued_by_tenant.get(tenant, 0)
                        >= PROXY_MAX_QUEUED_PER_TENANT
                        or self.queued_body_bytes + body_bytes
                        > PROXY_MAX_QUEUED_BODY_BYTES):
                    raise AdmissionOverload("ADMISSION_QUEUE_FULL",
                                            "local inference queue is full")
                self.queued += 1
                self.queued_body_bytes += body_bytes
                self.queued_by_tenant[tenant] = \
                    self.queued_by_tenant.get(tenant, 0) + 1
                self.sequence += 1
                entry = {"metadata": metadata, "body_bytes": body_bytes,
                         "enqueued_at": started, "sequence": self.sequence,
                         "future": asyncio.get_running_loop().create_future(),
                         "admitted": False}
                self.queue.append(entry)
                self._dispatch()
        try:
            return await asyncio.wait_for(asyncio.shield(entry["future"]), timeout)
        except asyncio.TimeoutError as error:
            async with self.condition:
                if entry["admitted"]:
                    self._release(metadata)
                elif entry in self.queue:
                    self._remove_queued(entry)
                self._dispatch()
            raise AdmissionOverload(
                "ADMISSION_DEADLINE_EXCEEDED",
                "local inference queue deadline expired") from error
        except asyncio.CancelledError:
            async with self.condition:
                if entry["admitted"]:
                    self._release(metadata)
                elif entry in self.queue:
                    self._remove_queued(entry)
                self._dispatch()
            raise

    async def release(self, metadata: dict) -> None:
        """Release one active or reserved slot and dispatch queued work."""
        async with self.condition:
            self._release(metadata)
            self._dispatch()

    async def snapshot(self) -> dict:
        """Return bounded queue state without exposing tenant or request IDs."""
        async with self.condition:
            now = time.monotonic()
            queued_by_class = {name: 0 for name in PROXY_WORK_CLASSES}
            oldest_ms = {name: 0 for name in PROXY_WORK_CLASSES}
            for entry in self.queue:
                work_class = entry["metadata"]["class"]
                queued_by_class[work_class] += 1
                waited = round((now - entry["enqueued_at"]) * 1000)
                oldest_ms[work_class] = max(oldest_ms[work_class], waited)
            return {
                "active": self.active,
                "maxActive": PROXY_SHADOW_MAX_ACTIVE,
                "activeByClass": dict(self.active_by_class),
                "queued": self.queued,
                "maxQueued": PROXY_MAX_QUEUED,
                "queuedByClass": queued_by_class,
                "queuedBodyBytes": self.queued_body_bytes,
                "maxQueuedBodyBytes": PROXY_MAX_QUEUED_BODY_BYTES,
                "oldestQueueMsByClass": oldest_ms,
                "permits": len(self.permits),
            }

    async def reserve(self, metadata: dict) -> tuple[str, float]:
        """Acquire a single-use permit whose reservation expires quickly."""
        waited = await self.enter(metadata)
        expiry = None
        try:
            token = secrets.token_urlsafe(32)
            expiry = asyncio.create_task(self._expire(token))
            async with self.condition:
                self.permits[token] = (metadata, expiry)
            return token, waited
        except BaseException:
            # Cancellation can arrive after enter() occupies the slot but
            # before the permit becomes visible. Never strand that capacity.
            if expiry is not None:
                expiry.cancel()
            await self.release(metadata)
            raise

    async def _expire(self, token: str) -> None:
        await asyncio.sleep(PROXY_PERMIT_TTL_S)
        async with self.condition:
            permit = self.permits.pop(token, None)
            if permit is not None:
                self._release(permit[0])
                self._dispatch()

    async def consume(self, token: str, metadata: dict) -> dict:
        """Consume a permit only when its bound scheduling identity matches."""
        async with self.condition:
            permit = self.permits.get(token)
            if permit is None:
                raise AdmissionOverload("ADMISSION_PERMIT_INVALID",
                                        "admission permit is absent, expired, or consumed")
            reserved, expiry = permit
            fields = ("class", "tenant_raw", "request_id")
            if any(reserved[field] != metadata[field] for field in fields):
                raise AdmissionOverload("ADMISSION_PERMIT_MISMATCH",
                                        "admission permit does not match the model request")
            self.permits.pop(token)
            expiry.cancel()
            return reserved

    async def revoke(self, token: str) -> None:
        """Release an unconsumed permit after its acquire client disappears."""
        async with self.condition:
            permit = self.permits.pop(token, None)
            if permit is not None:
                permit[1].cancel()
                self._release(permit[0])
                self._dispatch()


async def read_http_request(reader) -> tuple[str, str, list[str], bytes]:
    """Read exactly one HTTP request: request line, headers, and body.

    Raises asyncio.IncompleteReadError (or ValueError) if the peer goes quiet
    mid-request; the caller closes the connection — half-consumed bytes
    cannot be relayed.
    """
    head = await reader.readuntil(b"\r\n\r\n")
    lines = head[:-4].decode("latin-1").split("\r\n")
    request_line, header_lines = lines[0], lines[1:]
    method, path, _version = request_line.split(" ", 2)

    fields: dict[str, str] = {}
    for line in header_lines:
        key, sep, value = line.partition(":")
        if sep:
            fields[key.strip().lower()] = value.strip()

    body = b""
    if "chunked" in fields.get("transfer-encoding", "").lower():
        while True:
            size_line = await reader.readuntil(b"\r\n")
            size = int(size_line.split(b";")[0] or b"0", 16)
            if size == 0:
                while True:                     # trailers end at the blank line
                    if await reader.readuntil(b"\r\n") == b"\r\n":
                        break
                break
            if size < 0 or len(body) + size > PROXY_MAX_REQUEST_BODY_BYTES:
                raise ValueError("request body exceeds proxy limit")
            body += await reader.readexactly(size)
            if await reader.readexactly(2) != b"\r\n":
                raise ValueError("chunk data has no CRLF terminator")
    elif "content-length" in fields:
        length = int(fields["content-length"])
        if length < 0 or length > PROXY_MAX_REQUEST_BODY_BYTES:
            raise ValueError("request body exceeds proxy limit")
        body = await reader.readexactly(length)
    return method, path, header_lines, body


def build_request_head(method: str, path: str,
                       header_lines: list[str], body: bytes) -> bytes:
    """Reframe the head for the forwarded body.

    Content-Length is replaced (the rewrite may have changed the size), and
    `Connection: close` is imposed: each client connection then carries
    exactly one exchange, so no side has to guess where the relayed response
    ended — uvicorn mirrors the close on its response, and clients open a
    fresh connection per request.
    """
    dropped = {"content-length", "transfer-encoding", "connection",
               *PROXY_SCHEDULING_HEADERS}
    kept = [line for line in header_lines
            if not line or ":" not in line
            or line.split(":", 1)[0].strip().lower() not in dropped]
    kept.append(f"Content-Length: {len(body)}")
    kept.append("Connection: close")
    return (f"{method} {path} HTTP/1.1\r\n"
            + "\r\n".join(kept) + "\r\n\r\n").encode("latin-1")


def is_inference_request(method: str, path: str) -> bool:
    """Return whether a request consumes a vLLM generation slot.

    Anthropic token counting shares the `/v1/messages` prefix but performs no
    generation. Counting it against admission capacity creates false queue
    decisions precisely when a client fans out context accounting requests.
    """
    endpoint = path.partition("?")[0]
    return method == "POST" and endpoint in {
        "/v1/messages", "/v1/chat/completions", "/v1/completions",
    }


def acquire_metadata(body: bytes) -> dict:
    """Validate one DSH-aware permit request into proxy scheduling metadata."""
    try:
        request = json.loads(body)
    except (UnicodeDecodeError, ValueError) as error:
        raise ValueError("admission acquire body must be JSON") from error
    if not isinstance(request, dict):
        raise ValueError("admission acquire body must be an object")
    work_class = request.get("class")
    if work_class not in PROXY_WORK_CLASSES:
        raise ValueError("admission acquire class is invalid")
    request_id = request.get("requestId")
    tenant = request.get("tenant", "legacy")
    purpose = request.get("purpose", "unspecified")
    for name, value in (("requestId", request_id), ("tenant", tenant),
                        ("purpose", purpose)):
        if value is not None and (not isinstance(value, str)
                                  or len(value) > PROXY_METADATA_MAX_CHARS
                                  or "\r" in value or "\n" in value):
            raise ValueError(f"admission acquire {name} is invalid")
    deadline = request.get("deadlineMs",
                           PROXY_QUEUE_DEADLINES_MS[work_class])
    if not isinstance(deadline, int) or isinstance(deadline, bool) or deadline <= 0:
        raise ValueError("admission acquire deadlineMs is invalid")
    tenant_digest = hashlib.sha256(tenant.encode("utf-8")).hexdigest()[:12]
    return {"class": work_class, "purpose": purpose,
            "source": "acquire", "tenant": tenant_digest,
            "tenant_raw": tenant, "request_id": request_id,
            "deadline_ms": deadline, "invalid": False}


async def proxy_json(writer, status: int, payload: dict) -> None:
    """Write one bounded JSON response and close its loopback connection."""
    body = json.dumps(payload, separators=(",", ":")).encode("utf-8")
    reasons = {200: "OK", 400: "Bad Request", 409: "Conflict",
               429: "Too Many Requests"}
    head = (
        f"HTTP/1.1 {status} {reasons[status]}\r\n"
        "Content-Type: application/json\r\n"
        f"Content-Length: {len(body)}\r\n"
        "Connection: close\r\n\r\n").encode("latin-1")
    writer.write(head + body)
    try:
        await writer.drain()
    finally:
        writer.close()


async def while_client_connected(operation, reader):
    """Await admission while cancelling it promptly when the client closes."""
    pending = asyncio.create_task(operation)
    disconnected = asyncio.create_task(reader.read(1))
    done, _ = await asyncio.wait(
        {pending, disconnected}, return_when=asyncio.FIRST_COMPLETED)
    if pending in done:
        disconnected.cancel()
        try:
            await disconnected
        except asyncio.CancelledError:
            pass
        return await pending
    pending.cancel()
    try:
        await pending
    except asyncio.CancelledError:
        pass
    return None


async def proxy_serve(listen_port: int, uds: str) -> None:
    """Relay 127.0.0.1:listen_port to the Unix socket.

    Responses are byte-for-byte streamed (a token stream must reach the
    client as it is produced). Requests are read whole first, because the one
    rewrite this proxy makes — thinking off for the auto-mode classifier and
    for explicit thinking:disabled — needs the JSON body.
    """
    async def pump(reader, writer) -> None:
        try:
            while True:
                chunk = await reader.read(PROXY_CHUNK)
                if not chunk:
                    break
                # Forwarded chunk by chunk and drained: a token stream must
                # reach the client as it is produced. Accumulating a whole
                # response here would turn streaming chat into a long silence
                # followed by a wall of text.
                writer.write(chunk)
                await writer.drain()
        except OSError:
            pass
        finally:
            try:
                writer.close()
            except OSError:
                pass

    shadow_active = 0
    admission = AdmissionController()

    async def handle(client_reader, client_writer) -> None:
        nonlocal shadow_active
        tracked = False
        admission_metadata = None
        try:
            method, path, header_lines, body = await asyncio.wait_for(
                read_http_request(client_reader), PROXY_REQUEST_TIMEOUT_S)
            if method == "GET" and path.partition("?")[0] \
                    == "/_aivan/admission/status":
                await proxy_json(client_writer, 200,
                                 await admission.snapshot())
                return
            if method == "POST" and path.partition("?")[0] \
                    == "/_aivan/admission/acquire":
                try:
                    metadata = acquire_metadata(body)
                    acquired = await while_client_connected(
                        admission.reserve(metadata), client_reader)
                    if acquired is None:
                        return
                    permit, waited = acquired
                    say("proxy: admission phase3 "
                        f"action=reserve class={metadata['class']} "
                        f"purpose={metadata['purpose']} source=acquire "
                        f"tenant={metadata['tenant']} active={admission.active} "
                        f"queue_wait_ms={round(waited)}")
                except ValueError as error:
                    await proxy_json(client_writer, 400, {
                        "error": {"code": "ADMISSION_INVALID_REQUEST",
                                  "message": str(error)}})
                    return
                except AdmissionOverload as error:
                    await proxy_json(client_writer, 429, {
                        "error": {"code": error.code,
                                  "message": str(error)}})
                    return
                try:
                    await proxy_json(client_writer, 200, {
                        "permit": permit,
                        "expiresInMs": int(PROXY_PERMIT_TTL_S * 1000),
                        "queueWaitMs": round(waited),
                    })
                except (ConnectionError, OSError):
                    await admission.revoke(permit)
                return
            inference = is_inference_request(method, path)
            if inference:
                metadata = shadow_metadata(path, header_lines, body)
                decision = ("would-admit" if shadow_active < PROXY_SHADOW_MAX_ACTIVE
                            else "would-queue")
                shadow_active += 1
                tracked = True
                say("proxy: admission shadow "
                    f"decision={decision} class={metadata['class']} "
                    f"purpose={metadata['purpose']} source={metadata['source']} "
                    f"tenant={metadata['tenant']} active={shadow_active}")
                permit = header_fields(header_lines).get("x-aivan-admission")
                admission_path = "compat"
                try:
                    if permit is None:
                        waited = await while_client_connected(
                            admission.enter(metadata, len(body)), client_reader)
                        if waited is None:
                            shadow_active -= 1
                            tracked = False
                            return
                        admission_metadata = metadata
                    else:
                        admission_metadata = await admission.consume(permit, metadata)
                        waited = 0.0
                        admission_path = "permit"
                except AdmissionOverload as error:
                    shadow_active -= 1
                    tracked = False
                    await proxy_json(client_writer, 429, {
                        "error": {"code": error.code,
                                  "message": str(error)}})
                    return
                say("proxy: admission phase3 "
                    f"action=admit class={metadata['class']} "
                    f"purpose={metadata['purpose']} source={metadata['source']} "
                    f"tenant={metadata['tenant']} active={admission.active} "
                    f"queue_wait_ms={round(waited)} path={admission_path}")
            body, reason = rewrite_thinking_off(path, body)
            if reason:
                say(f"proxy: thinking off for {path} ({reason})")
            request = build_request_head(method, path, header_lines, body) + body
        except (OSError, EOFError, ValueError, asyncio.TimeoutError):
            # A half-read request cannot be relayed; closing looks exactly
            # like a dead server, which is what consumers must never hang on.
            if tracked:
                shadow_active -= 1
                tracked = False
            try:
                client_writer.close()
            except OSError:
                pass
            return
        try:
            try:
                upstream_reader, upstream_writer = await asyncio.wait_for(
                    asyncio.open_unix_connection(uds), PROXY_UPSTREAM_CONNECT_S)
            except (OSError, asyncio.TimeoutError):
                # vLLM is not up yet, or has gone. Close immediately: hanging here
                # would reproduce the exact symptom this proxy exists to avoid.
                try:
                    client_writer.close()
                except OSError:
                    pass
                return
            try:
                upstream_writer.write(request)
                await upstream_writer.drain()
            except OSError:
                # Upstream died between connect and write; same remedy as above.
                try:
                    client_writer.close()
                except OSError:
                    pass
                return
            await asyncio.gather(pump(client_reader, upstream_writer),
                                 pump(upstream_reader, client_writer))
        finally:
            if tracked:
                shadow_active -= 1
            if admission_metadata is not None:
                await admission.release(admission_metadata)

    server = await asyncio.start_server(handle, HOST, listen_port,
                                        backlog=PROXY_BACKLOG)
    async with server:
        await server.serve_forever()


def cmd_proxy(args: argparse.Namespace) -> int:
    try:
        asyncio.run(proxy_serve(args.port, args.uds))
    except KeyboardInterrupt:
        return RC_OK
    except OSError as exc:
        say(f"proxy on {HOST}:{args.port} failed: {exc}")
        return RC_FAIL
    return RC_OK


def start_proxy(port: int, uds: str, log) -> subprocess.Popen | None:
    """Launch the proxy as a CHILD PROCESS, deliberately.

    A thread could die and leave this process holding the listening socket, so
    consumers would connect and hang against a proxy that is no longer relaying
    — the silent failure. A separate process cannot: when it dies the kernel
    closes its socket, and 127.0.0.1:PORT starts refusing at once, which is
    exactly what a dead server looks like.
    """
    command = [sys.executable, os.path.abspath(__file__), "_proxy",
               "--port", str(port), "--uds", uds]
    try:
        proxy = subprocess.Popen(command, stdout=log, stderr=subprocess.STDOUT,
                                 stdin=subprocess.DEVNULL)
    except OSError as exc:
        say(f"cannot start the proxy: {exc}")
        return None

    # Return only once the port actually accepts. `Popen` returning proves a
    # process exists, not that anything is listening, and everything after this
    # — the recorded state, a caller's probe, the engine build — reads a live
    # proxy pid as a served port. Whoever loses that race sees a connection
    # refused on a port this launcher has already claimed to be holding.
    deadline = time.monotonic() + PROXY_BIND_TIMEOUT_S
    while time.monotonic() < deadline:
        if proxy.poll() is not None:
            say(f"the proxy exited rc={proxy.returncode} before it bound "
                f"{HOST}:{port}")
            return None
        if port_in_use(port):
            return proxy
        time.sleep(0.05)
    say(f"the proxy did not bind {HOST}:{port} within "
        f"{PROXY_BIND_TIMEOUT_S:.0f}s; refusing to build an engine behind a "
        "port nothing is serving")
    stop_proxy(proxy)
    return None


def stop_proxy(proxy: subprocess.Popen | None) -> None:
    """Kill the proxy FIRST, so the TCP port refuses while teardown proceeds."""
    if proxy is None or proxy.poll() is not None:
        return
    proxy.terminate()
    try:
        proxy.wait(timeout=10)
    except subprocess.TimeoutExpired:
        proxy.kill()
        proxy.wait()


# --------------------------------------------------------------------------
# _supervise — `arm run`'s direct child; the lease lives exactly as long as it
# --------------------------------------------------------------------------

def cmd_supervise(args: argparse.Namespace) -> int:
    stopping = {"signal": None}

    def request_stop(signum, _frame):
        stopping["signal"] = signum

    for signum in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signum, request_stop)

    baseline = read_gpu_used_mib()
    if baseline is None and args.arbitrated:
        # Arbitrated box, unreadable card: we could never prove the VRAM came
        # back, so the guarantee this process exists to make is unavailable.
        say("cannot read nvidia-smi; refusing to take the card under a lease "
            "whose release could not be justified")
        return RC_ARM_ERROR
    say(f"VRAM baseline before launch: "
        f"{'unknown' if baseline is None else str(baseline) + ' MiB'}")

    # The proxy goes up FIRST and stays up for the whole engine build. Holding
    # the TCP port with a socket that binds and listens together is the entire
    # point: vLLM's own port would sit bound-but-not-listening for that time.
    proxy = None
    if args.uds:
        proxy = start_proxy(args.port, args.uds, sys.stdout)
        if proxy is None:
            return RC_FAIL
        say(f"proxy pid {proxy.pid}: {HOST}:{args.port} -> {args.uds}")

    command = [str(args.vllm_bin), *args.vllm_args]
    say(f"launching: {' '.join(command)}")
    try:
        # Its own session, so its group id is its PID and every fork it makes —
        # including VLLM::EngineCore — lands in that one recorded group.
        child = subprocess.Popen(command, start_new_session=True,
                                 env={**os.environ, **SERVER_ENV})
    except OSError as exc:
        say(f"cannot start {command[0]!r}: {exc}")
        stop_proxy(proxy)
        return RC_FAIL

    # `start_new_session` should have made the child its own group leader. Read
    # it back rather than assume: everything this script kills, it kills by this
    # number, and a group id that is not one we created could name anybody's
    # processes on a shared box.
    try:
        pgid = os.getpgid(child.pid)
    except ProcessLookupError:
        pgid = child.pid  # exited already; the group it led went with it
    if pgid != child.pid:
        say(f"REFUSING: {command[0]!r} landed in process group {pgid}, not its "
            f"own ({child.pid}). Tearing it down by PID and stopping, rather "
            "than taking a group this launcher did not create.")
        child.terminate()
        child.wait()
        stop_proxy(proxy)
        return RC_FAIL

    wrapper_pid = os.getppid()            # `arm run`, or `start` when unclaimed
    # Read from the composed argv, not the register: `start` already resolved
    # the profile and built this exact `--served-model-name` into
    # `args.vllm_args`, so re-deriving it here can never disagree with what
    # is actually being served — same reasoning as `check_kv_pool_fits_window`
    # reading the model path from `serve_args` rather than a profile value.
    served_model_name = last_flag_value(args.vllm_args, "--served-model-name")
    write_state({
        "phase": "serving",
        "serve_args": list(args.vllm_args),
        "wrapper_pid": wrapper_pid,
        "wrapper_start_ticks": pid_start_ticks(wrapper_pid),
        "supervisor_pid": os.getpid(),
        "supervisor_start_ticks": pid_start_ticks(os.getpid()),
        "vllm_pid": child.pid,
        "vllm_pgid": pgid,
        "proxy_pid": proxy.pid if proxy else None,
        "uds": args.uds,
        "vram_baseline_mib": baseline,
        "arbitrated": args.arbitrated,
        "host": HOST,
        "port": args.port,
        "model": served_model_name,
        # `profile` (2026-08-27) used to be written only by `start`'s own
        # `starting`-phase record and never refreshed here, so it went stale
        # the instant the phase flipped to `serving` — this write is what
        # closes that (dsh-serve-state-profile-field-always-null).
        "profile": args.profile,
        # Stamped here, after the exec above — not at verb invocation. It is
        # the wall clock's reading of when this vLLM began, to within the
        # milliseconds between `Popen` and this line.
        "started_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    })
    say(f"vllm pid {child.pid}, process group {pgid}")

    proxy_died = False
    became_healthy = False
    consecutive_misses = 0
    mid_session_captured = False
    next_probe = time.monotonic()  # check immediately, not after one interval
    while child.poll() is None and stopping["signal"] is None:
        if proxy is not None and proxy.poll() is not None:
            proxy_died = True
            break
        now = time.monotonic()
        if now >= next_probe:
            next_probe = now + MID_SESSION_PROBE_INTERVAL_S
            if server_ready(args.port):
                became_healthy = True
                consecutive_misses = 0
                mid_session_captured = False
            elif became_healthy:
                # Gated on `became_healthy`: a server that never came up at all
                # is `await_ready`'s own capture, in a different process — this
                # one is specifically for "answered fine, then stopped", which
                # nothing else here watches for.
                consecutive_misses += 1
                if (consecutive_misses >= MID_SESSION_MISS_THRESHOLD
                        and not mid_session_captured):
                    mid_session_captured = True
                    say(f"WARNING: /health has missed "
                        f"{consecutive_misses} times in a row "
                        f"({MID_SESSION_PROBE_INTERVAL_S:.0f}s apart) after "
                        "answering fine earlier this session — capturing "
                        "evidence. NOT restarting or stopping anything; a "
                        "human decides what to do with this.")
                    capture_unreachable_evidence(
                        args.port,
                        f"/health stopped answering mid-session: "
                        f"{consecutive_misses} consecutive misses "
                        f"{MID_SESSION_PROBE_INTERVAL_S:.0f}s apart, "
                        "following at least one earlier successful /health "
                        "this session (not a startup failure)")
        time.sleep(0.2)

    if proxy_died:
        # A live engine nobody can reach is the silent failure this whole
        # exercise exists to avoid, so it is fatal rather than a warning: shut
        # down, give the card back, and let the operator see why.
        say(f"PROXY DIED rc={proxy.returncode} while vllm was still running. "
            f"{HOST}:{args.port} is no longer served, so the engine is "
            "unreachable — tearing down rather than holding the card for a "
            "server nobody can talk to.")
    elif stopping["signal"] is not None:
        say(f"got signal {stopping['signal']}; tearing down process group {pgid}")
    else:
        # The direct child exited on its own. This is exactly the path where a
        # bare `arm run` would release over a full card.
        say(f"vllm exited rc={child.returncode}; sweeping process group {pgid} "
            "for survivors before releasing anything")

    # Before the engine, so the TCP port starts refusing immediately instead of
    # relaying into a server that is shutting down under it.
    stop_proxy(proxy)
    rc = teardown(child, pgid, baseline, args.arbitrated, args.vram_timeout)
    try:
        state_path().unlink()
    except OSError:
        pass
    if args.uds:
        try:
            Path(args.uds).unlink()
        except OSError:
            pass
    return rc if not proxy_died else RC_FAIL


def teardown(child: subprocess.Popen, pgid: int, baseline: int | None,
             arbitrated: bool, vram_timeout: float) -> int:
    """Empty the recorded group, then prove the VRAM came back. Only then may
    this process exit, because its exit is what releases the lease."""
    # Signal the group BEFORE reaping. While the group leader is an unreaped
    # child of ours its PID cannot be recycled, and a group id is its leader's
    # PID — so `pgid` cannot come to mean somebody else's processes here.
    for sig, grace in ((signal.SIGTERM, TERM_GRACE_S), (signal.SIGKILL, 10.0)):
        remaining = pgid_members(pgid)
        if not remaining:
            break
        try:
            os.killpg(pgid, sig)
        except ProcessLookupError:
            break
        say(f"sent {sig.name} to process group {pgid} ({len(remaining)} member(s))")
        deadline = time.monotonic() + grace
        while time.monotonic() < deadline and pgid_members(pgid):
            time.sleep(0.1)

    survivors = pgid_members(pgid)
    rc = child.wait()
    rc = 128 - rc if rc < 0 else rc

    if not confirm_card_returned(baseline, pgid, survivors, arbitrated,
                                 vram_timeout):
        return RC_VRAM_HELD
    return rc


def confirm_card_returned(baseline: int | None, pgid: int, survivors: list[int],
                          arbitrated: bool, vram_timeout: float) -> bool:
    """True once nothing this launcher started still holds the card.

    Two pieces of evidence, in order of directness. The recorded process group
    being empty is the primary one — it is exact, and it is the thing under this
    launcher's control. The `nvidia-smi` reading is the check on top of it,
    because the figure is device-wide (per-process attribution is blind under
    WSL2) and can lag the driver's reclaim.
    """
    if survivors:
        return hold_or_warn(
            arbitrated,
            f"process group {pgid} still has members after SIGKILL: {survivors}. "
            "Something this launcher started is still on the card.")

    if baseline is None:
        # Only reachable if nvidia-smi disappeared mid-run; `_supervise` refuses
        # to start an arbitrated run without a baseline. The group is provably
        # empty, which is the stronger evidence, so this warns rather than
        # stranding the pool on a reading that will never arrive.
        say(f"WARNING: process group {pgid} is empty, but nvidia-smi cannot be "
            "read, so the VRAM's return is unverified")
        return False

    ceiling = baseline + VRAM_RETURNED_TOLERANCE_MIB
    deadline = time.monotonic() + vram_timeout
    while True:
        used = read_gpu_used_mib()
        if used is not None and used <= ceiling:
            say(f"VRAM returned: {used} MiB in use, baseline {baseline} MiB")
            return True
        if time.monotonic() >= deadline:
            break
        time.sleep(1.0)

    seen = read_gpu_used_mib()
    return hold_or_warn(
        arbitrated,
        f"VRAM did not return within {vram_timeout:.0f}s (in use "
        f"{'unreadable' if seen is None else str(seen) + ' MiB'}, baseline "
        f"{baseline} MiB) after emptying process group {pgid}.")


def hold_or_warn(arbitrated: bool, finding: str) -> bool:
    """Never release a lease over a card that is still held.

    Under a lease this does not return: it keeps the pool marked busy and says
    why, forever. An over-held lease costs a queue and is visible in
    `arm status`; an under-held one hands the next tenant a full card, and on
    WSL2 that does not fail — it spills to host memory and quietly runs 10-40x
    slower.
    """
    if not arbitrated:
        say(f"WARNING: {finding} No lease is held, so nothing is being promised "
            "to anyone — but the card is not free.")
        return False
    # SIGTERM is already spoken for as "begin an orderly stop", and this IS the
    # orderly stop, refusing to finish. Releasing anyway has to be a separate,
    # deliberate act, so it takes SIGKILL — which a repeated `dsh-serve stop`
    # cannot do by accident.
    say(f"REFUSING TO RELEASE: {finding} Holding the {POOL} lease so ARM keeps "
        f"the card marked busy. Investigate with `arm audit`. Once the card is "
        f"genuinely free, release it with `kill -9 {os.getpid()}` — SIGTERM "
        "will not do it.")
    while True:
        time.sleep(STUCK_REPORT_INTERVAL_S)
        seen = read_gpu_used_mib()
        say(f"still holding the {POOL} lease: VRAM in use "
            f"{'unreadable' if seen is None else str(seen) + ' MiB'}, "
            f"supervisor pid {os.getpid()}")


# --------------------------------------------------------------------------
# start
# --------------------------------------------------------------------------

def cmd_start(args: argparse.Namespace) -> int:
    if args.prio and args.prio != REGISTERED_PRIO and not args.purpose:
        die(f"--prio {args.prio} overrides the registered default "
            f"({REGISTERED_PRIO}); state the reason in --purpose", RC_FAIL)

    # Held for the whole verb, so two callers cannot both pass the checks below
    # and then both spawn. A machine caller makes that race reachable in a way a
    # human at a terminal never did.
    lock = take_start_lock()
    if lock is None:
        die("another `dsh-serve start` is in progress (it holds "
            f"{lock_path()}). Wait for it, then read `dsh-serve status`.",
            RC_FAIL)

    uds = str(uds_path()) if getattr(args, "uds", False) else None
    profile_name, profile = resolve_profile(getattr(args, "model", None))
    serve_args = [*vllm_args(profile, args.port, uds), *args.vllm_args]

    live = read_state()
    if live and (pid_alive(live.get("supervisor_pid"),
                           live.get("supervisor_start_ticks"))
                 or pid_alive(live.get("wrapper_pid"),
                              live.get("wrapper_start_ticks"))):
        where = (f"supervisor pid {live.get('supervisor_pid')}, "
                 f"vllm pid {live.get('vllm_pid')}"
                 if state_phase(live) == "serving"
                 else f"a start is in flight (wrapper pid "
                      f"{live.get('wrapper_pid')})")
        if not args.if_not_running:
            die(f"already running: {where}. Use `dsh-serve stop`, or "
                "`start --if-not-running` to accept it.", RC_ALREADY_RUNNING)
        return accept_running(live, serve_args)
    if port_in_use(args.port):
        die(f"{HOST}:{args.port} is already serving. Something outside this "
            "launcher holds the card — leave it alone, or stop it the way it "
            "was started.", RC_FAIL)

    vllm_bin = Path(args.vllm_bin)
    if not os.access(vllm_bin, os.X_OK):
        die(f"vllm not executable at {vllm_bin}", RC_FAIL)

    if uds:
        state_dir().mkdir(parents=True, exist_ok=True)
        stale = prepare_uds(Path(uds))
        if stale:
            die(stale, RC_FAIL)

    incoherent = check_kv_pool_fits_window(serve_args)
    if incoherent:
        die(incoherent, RC_FAIL)

    drifted = check_settings_context_window(profile["max_model_len"],
                                            profile["served_model_name"])
    if drifted:
        die(drifted, RC_FAIL)

    # Books, not binary: a missing PATH entry must never read as "no arbiter".
    arbitrated = books_path().exists()
    if arbitrated and not arm_available():
        die(f"{books_path()} says this box is arbitrated, but `arm` cannot be "
            "run. That is a refusal, not an absence of arbitration — this "
            "would take 25 GB of a shared card behind ARM's back. Fix the PATH "
            "(prepend ~/bin) or the ARM install.", RC_ARM_ERROR)
    if not arbitrated:
        say(f"no {books_path()} — no arbiter on this box; starting UNCLAIMED")

    prio = args.prio or REGISTERED_PRIO
    purpose = args.purpose or (
        f"dsh: {profile['served_model_name']} ({profile_name}) NVFP4 vLLM "
        f"server on {HOST}:{args.port} (deepseek-harness backend)")

    supervise = [
        sys.executable, os.path.abspath(__file__), "_supervise",
        "--vllm-bin", str(vllm_bin), "--port", str(args.port),
        "--vram-timeout", str(args.vram_timeout),
        "--profile", profile_name,
    ]
    if uds:
        supervise += ["--uds", uds]
    if arbitrated:
        supervise.append("--arbitrated")
    supervise += ["--", *serve_args]

    if arbitrated:
        command = [
            "arm", "run", POOL, "--app", APP, "--exclusive",
            "--prio", prio, "--purpose", purpose,
        ]
        if args.wait:
            command += ["--wait", "--timeout", str(args.wait)]
        command += ["--", *supervise]
    else:
        command = supervise

    state_dir().mkdir(parents=True, exist_ok=True)
    log = open(log_path(), "a")
    log.write(f"\n=== dsh-serve start {time.strftime('%Y-%m-%dT%H:%M:%S%z')} ===\n")
    log.flush()
    say(f"logging to {log_path()}")
    # setsid: the wrapper is the lease holder and must outlive this process
    # without inheriting its terminal (`arm run`'s documented detached shape).
    wrapper = subprocess.Popen(command, stdout=log, stderr=subprocess.STDOUT,
                               stdin=subprocess.DEVNULL, start_new_session=True)

    # Recorded HERE, before anything is serving, because this is what makes a
    # `stop` arriving mid-start safe. The supervisor's own record lands minutes
    # later — after the ARM queue and the VRAM baseline — and until 2026-08-27
    # nothing existed in between: `stop` found no state, said "nothing is
    # running", exited 0, and left a server that was still on its way up to take
    # the card unattended. The window is unbounded when the claim is queued.
    write_state({
        "phase": "starting",
        "wrapper_pid": wrapper.pid,
        "wrapper_start_ticks": pid_start_ticks(wrapper.pid),
        "arbitrated": arbitrated,
        "host": HOST,
        "port": args.port,
        "uds": uds,
        "model": profile["served_model_name"],
        "profile": profile_name,
        "serve_args": serve_args,
        "started_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    })

    rc = await_ready(wrapper, arbitrated, args.ready_timeout, args.port, uds)
    log.close()
    if rc != RC_OK and wrapper.poll() is not None:
        clear_starting_state(wrapper.pid)
    return rc


def clear_starting_state(wrapper_pid: int) -> None:
    """Remove OUR `starting` record once the wrapper is gone without serving.

    Conditioned on the phase and the pid: a supervisor that got as far as
    serving has already overwritten this record, and deleting that one would
    strand a live server with no way to stop it.
    """
    live = read_state()
    if (live and state_phase(live) == "starting"
            and live.get("wrapper_pid") == wrapper_pid):
        try:
            state_path().unlink()
        except OSError:
            pass


def warn_unreachable_likely(elapsed_s: float) -> None:
    """Fires once per attempt, direct-TCP only, past
    `DIRECT_TCP_UNREACHABLE_WARN_S`. A WARNING, never an abort: a legitimately
    slow load must still be allowed to finish, so this never touches the
    wait's outcome, only what a human watching can see about it.

    Printed on stderr (`say`) AND appended to `server.log` directly, because
    neither alone is enough: `say`'s periodic progress lines never reach
    `server.log` (they go only to this process's own stderr), so a start
    launched detached or into a redirect nobody is watching would otherwise
    say this to no one; the log-only half would miss the one person actually
    staring at a hand-typed `dsh-serve start` at the terminal, which is the
    worst-case scenario this exists for (see
    vllm-loopback-unreachable-after-config-change memory, 2026-09-03 incident).
    """
    message = (
        f"⚠️  {elapsed_s:.0f}s since launch with no /health response yet, on "
        f"direct TCP (no --uds). In this box's own history, EVERY direct-TCP "
        f"start that took {DIRECT_TCP_UNREACHABLE_WARN_S:.0f}s or longer to "
        "reach 'HTTP server started' went permanently unreachable (0/14), "
        "against 6/6 reachable under 68s — this is very likely wedged, not "
        "still loading. It will keep holding the GPU until the full "
        "--ready-timeout deadline (or `dsh-serve stop`) either way, so "
        "there is no harm in checking now: `dsh-serve status`. If it agrees, "
        "`dsh-serve stop` then retry with `dsh-serve start --uds` (13/13 "
        "reachable in the same history, any duration).")
    say(message)
    try:
        with open(log_path(), "a") as log:
            log.write(f"dsh-serve: {message}\n")
    except OSError:
        pass  # the stderr line above is the guarantee; a log write is a bonus


def await_ready(wrapper: subprocess.Popen, arbitrated: bool,
                timeout_s: float, port: int, uds: str | None) -> int:
    """Poll for the server, watching the wrapper for an early exit — an ARM
    pre-exec refusal must surface in seconds, not after the readiness timeout."""
    started = time.monotonic()
    deadline = started + timeout_s
    next_report = started + 15
    warned_unreachable = False
    while time.monotonic() < deadline:
        rc = wrapper.poll()
        if rc is not None:
            return report_wrapper_exit(rc, arbitrated)
        if server_ready(port):
            live = read_state() or {}
            used = read_gpu_used_mib()
            say(f"ready: {live.get('model')} on http://{HOST}:{port} "
                f"(vllm pid {live.get('vllm_pid')}, group {live.get('vllm_pgid')}"
                f"{'' if used is None else f', {used} MiB VRAM in use'})")
            if arbitrated:
                say(f"holding the {POOL} lease as `{APP}`; `dsh-serve stop` "
                    "gives the card back")
            return RC_OK
        elapsed = time.monotonic() - started
        if (not warned_unreachable and uds is None
                and elapsed >= DIRECT_TCP_UNREACHABLE_WARN_S):
            warned_unreachable = True
            warn_unreachable_likely(elapsed)
        if time.monotonic() >= next_report:
            # The state file appears when the server process starts, which is
            # what tells these two apart: queued for the pool is not the same
            # wait as loading weights, and reporting one as the other sends the
            # operator looking in the wrong place.
            live = read_state()
            if live is None:
                say(f"waiting: no server process yet — queued for the {POOL} "
                    "lease, or still starting")
            else:
                say(f"waiting: vllm pid {live.get('vllm_pid')} is up, loading "
                    "weights (~4 min cold, ~1 min with warm caches)")
            next_report = time.monotonic() + 60
        time.sleep(1.0)

    # The capture happens here, while the failed server is still up: every
    # section below is about a live listener that will not answer, and stopping
    # first would destroy the only state worth having.
    capture_unreachable_evidence(
        port, f"/health did not answer within {timeout_s:.0f}s of `dsh-serve start`")
    say(f"server did not answer /health within {timeout_s:.0f}s; the wrapper is "
        f"still running (pid {wrapper.pid}) and the card is still held. See "
        f"{log_path()}, then `dsh-serve stop` — this does NOT tear down by "
        "itself, deliberately: the failed server is the evidence.")
    return RC_READY_TIMEOUT


def report_wrapper_exit(rc: int, arbitrated: bool) -> int:
    """Map an exit that happened before the server came up. `arm run`'s pre-exec
    band (97/98/99) means the child never ran at all."""
    tail = ""
    try:
        with open(log_path()) as handle:
            tail = "".join(handle.readlines()[-15:])
    except OSError:
        pass
    if arbitrated and rc == ARM_RC_DENIED:
        say(f"ARM DENIED the claim (rc {rc}). This call is wrong, not early: "
            f"`{APP}` is probably not registered in {books_path()}. Retrying "
            "changes nothing.")
        outcome = RC_DENIED
    elif arbitrated and rc == ARM_RC_WOULD_BLOCK:
        who = describe_blockers()
        say(f"ARM WOULD BLOCK (rc {rc}) — the GPU is not free"
            f"{': ' + who if who else ''}. Not starting. Retry later, or "
            "`--wait SECS`.")
        outcome = RC_WOULD_BLOCK
    elif arbitrated and rc == ARM_RC_ERROR:
        say(f"ARM could not answer (rc {rc}). That is a refusal, never "
            "permission — not starting.")
        outcome = RC_ARM_ERROR
    else:
        say(f"the server process exited rc={rc} before answering /health")
        outcome = RC_FAIL
    if tail.strip():
        print(f"--- last lines of {log_path()} ---\n{tail}", file=sys.stderr)
    return outcome


# --------------------------------------------------------------------------
# try-vision — the guarded start: prove the eyes, or put the old server back
# --------------------------------------------------------------------------
#
# TD ruling, 2026-08-25: vision ships on the operator's word, and the start that
# ships it IS the end-to-end image test. Measurement established that the tower
# fits with the 128k window intact (see VISION_ARGS), but no image was ever
# served — two vision boots came up unreachable. So the one thing this verb must
# guarantee is that the operator's chat is working when it returns, whatever
# happened in between.
#
# Three outcomes, and only the first leaves vision running:
#   * server answers AND names the colour  -> vision verified, left serving
#   * server never answers by the deadline -> capture, restore text-only
#   * server answers but fails the image   -> capture, restore text-only
#
# The image test asserts on what the model SAYS, not on a 200. A 200 only proves
# the request was accepted; the colour proves the tower actually ran and its
# output reached the language model.

VISION_PROBE_RGB = (220, 20, 20)
VISION_PROBE_WORD = "red"
VISION_PROBE_EDGE = 256


def solid_png(width: int, height: int, rgb: tuple[int, int, int]) -> bytes:
    """A minimal 8-bit RGB PNG, built here so the probe needs no image library —
    this script runs under system Python, not the vLLM venv."""
    def chunk(tag: bytes, data: bytes) -> bytes:
        body = tag + data
        return (struct.pack(">I", len(data)) + body
                + struct.pack(">I", zlib.crc32(body) & 0xFFFFFFFF))

    scanlines = b"".join(b"\x00" + bytes(rgb) * width for _ in range(height))
    return (b"\x89PNG\r\n\x1a\n"
            + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(scanlines, 9))
            + chunk(b"IEND", b""))


def image_probe(port: int, served_model_name: str,
                timeout: float = 180.0) -> tuple[bool, str]:
    """Send one image and check the answer. Returns (passed, what happened).

    `served_model_name` must match the target server's own
    `--served-model-name`: vLLM rejects a request whose `model` field
    disagrees with what it was launched to serve, and each profile now has
    its own — this probe has no default to fall back on.
    """
    png = solid_png(VISION_PROBE_EDGE, VISION_PROBE_EDGE, VISION_PROBE_RGB)
    payload = {
        "model": served_model_name,
        "messages": [{"role": "user", "content": [
            {"type": "image_url", "image_url": {
                "url": "data:image/png;base64," + base64.b64encode(png).decode()}},
            {"type": "text",
             "text": "What single colour fills this image? Reply with one word."},
        ]}],
        "max_tokens": 16,
        "temperature": 0,
        # With thinking on, a small cap is consumed inside the think block and
        # `content` comes back null — which would fail the probe for the wrong
        # reason entirely.
        "chat_template_kwargs": {"enable_thinking": False},
    }
    request = urllib.request.Request(
        f"http://{HOST}:{port}/v1/chat/completions",
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            answer = json.load(response)
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode(errors="replace")[:400]
        return False, f"HTTP {exc.code}: {detail}"
    except (urllib.error.URLError, OSError, ValueError) as exc:
        return False, f"no answer: {type(exc).__name__}: {exc}"

    try:
        content = (answer["choices"][0]["message"].get("content") or "").strip()
        prompt_tokens = (answer.get("usage") or {}).get("prompt_tokens")
    except (KeyError, IndexError, TypeError) as exc:
        return False, f"unreadable response: {type(exc).__name__}: {exc}"

    got = f"answered {content!r} (prompt_tokens {prompt_tokens})"
    if VISION_PROBE_WORD not in content.lower():
        return False, f"the image was not seen correctly: {got}"
    return True, got


def start_namespace(args: argparse.Namespace, extra: list[str],
                    ready_timeout: float, *, uds: bool,
                    model: str | None) -> argparse.Namespace:
    """`start`'s arguments for one attempt. Built explicitly rather than mutated
    so the vision attempt and the restore cannot share a flag by accident.

    `model` is a required keyword, not read off `args.model`: the one caller
    that must NOT honor the request (`restore_known_good`) passes
    `KNOWN_GOOD_PROFILE` here explicitly, so the restore is structurally
    incapable of retrying whatever profile the failed attempt used.
    """
    return argparse.Namespace(
        prio=args.prio, purpose=args.purpose, wait=args.wait,
        vllm_bin=args.vllm_bin, port=args.port, uds=uds,
        ready_timeout=ready_timeout, vram_timeout=args.vram_timeout,
        # Never: an attempt that accepted a server it did not start would report
        # the eyes proven on a configuration it never launched.
        if_not_running=False, json=False,
        model=model,
        vllm_args=list(extra))


def stop_running(reason: str, timeout: float) -> bool:
    """Stop whatever this launcher has running. True if the card is free after."""
    live = read_state()
    if not (live and (pid_alive(live.get("supervisor_pid"),
                                live.get("supervisor_start_ticks"))
                      or pid_alive(live.get("wrapper_pid"),
                                   live.get("wrapper_start_ticks")))):
        return True
    say(f"stopping the running server: {reason}")
    return cmd_stop(argparse.Namespace(timeout=timeout, json=False)) == RC_OK


def restore_known_good(args: argparse.Namespace, why: str) -> int:
    """Put the text-only server back. This is the promise the verb makes.

    ⚠️ The restore lands on `--restore-port`, NOT on the port the attempt used.
    A test on another port must never be able to strand the operator's chat on a
    port nothing points at: `~/.dsh/settings.yaml` and the fleet chat's backend
    both name the shipped port, and neither is updated by this script.

    ⛔ KNOWN GOOD is defined as: the register's `KNOWN_GOOD_PROFILE`, text-only,
    `--uds`, no experiment arguments, on `--restore-port`. That is the exact
    configuration the operator has been served by, and the only one with a
    record of coming up. `--uds` only changes the internal transport to the
    engine; the client-visible port and interface are unchanged.

    ⛔ The profile is `KNOWN_GOOD_PROFILE` from the register, NEVER `args.model`
    — the defect this closes (2026-08-30): a restore that re-read whatever
    profile the failed attempt used could retry the exact broken checkpoint
    it exists to fall back FROM. `start_namespace`'s `model` keyword is
    required specifically so this call cannot silently default to `args.model`
    by omission. The restore also never inherits `--uds` from the attempt —
    it is hardcoded `True` here regardless of what the attempt used. Flipped
    2026-09-04 from hardcoded `False`: six classified restores showed direct
    TCP reachable in 4/6 (one confirmed unreachable, one very-likely) against
    `--uds`'s 13/13 over the same history, so direct TCP stopped being the
    more-proven path the original hardcoding relied on.
    """
    known_good = load_register()["KNOWN_GOOD_PROFILE"]
    say(f"RESTORING the known-good server ({known_good}) on port "
        f"{args.restore_port} — text-only, --uds ({why})")
    if not stop_running("clearing the failed vision attempt", STOP_WAIT_S):
        say("RESTORE BLOCKED: the failed server would not give the card back. "
            "The lease is deliberately still held. Investigate before retrying.")
        return RC_RESTORE_FAILED
    restore = start_namespace(args, [], args.restore_timeout, uds=True,
                              model=known_good)
    restore.port = args.restore_port
    rc = cmd_start(restore)
    if rc != RC_OK:
        say("RESTORE FAILED: the known-good text-only config did not come up "
            "either. The chat is DOWN and needs a human now.")
        return RC_RESTORE_FAILED
    say("restored: the text-only server is serving again, unchanged. Vision is "
        "OFF and nothing about the shipped configuration has moved.")
    return RC_FAIL


def accept_proven_vision(port: int) -> int | None:
    """`--if-not-running`: is the server that is already up captioning-ready?

    Returns RC_OK when an image round-trips through it right now, None to fall
    through to the full guarded start. The test is the round trip, never the
    recorded arguments — this verb's whole promise is that the eyes are proven
    rather than requested, and a consumer gating a chapter of captions on it
    needs that promise to mean the same thing on the idempotent path.

    ⛔ Deliberately does NOT restart a server that is already serving the
    operator's chat. Flipping `language_model_only` costs ~7 min of downtime,
    and doing that to prove something already true is the cost this flag exists
    to avoid.
    """
    live = read_state()
    if not (live and state_phase(live) == "serving"
            and pid_alive(live.get("supervisor_pid"),
                          live.get("supervisor_start_ticks"))):
        return None
    if live_port(live) != port or not server_ready(port):
        return None
    served_model_name = live.get("model")
    if not served_model_name:
        # A record from before per-profile served ids existed, or otherwise
        # missing the field: unknown what to ask the server to be, so fall
        # through to the full guarded start rather than guessing.
        return None
    say(f"a server is already serving on {HOST}:{port}; testing it for the eyes "
        "before considering a restart")
    passed, detail = image_probe(port, served_model_name)
    if not passed:
        say(f"it is up but cannot take an image ({detail}); continuing with the "
            "guarded vision start")
        return None
    mark_vision_proven(port)
    say(f"VISION ALREADY PROVEN on the running server: {detail}. Nothing was "
        "restarted.")
    return RC_OK


def cmd_try_vision(args: argparse.Namespace) -> int:
    """Bring the server up with the vision tower and prove an image round-trips,
    or put the known-good text-only server back."""
    # Resolved once, up front: the ATTEMPT's own served id, for the image
    # test below. Never `args.model` re-read later — `cmd_start` inside this
    # verb resolves it again independently for the actual launch, and both
    # reads must agree, which only holds if neither depends on state that
    # could change between them.
    _, attempt_profile = resolve_profile(args.model)
    if args.if_not_running:
        already = accept_proven_vision(args.port)
        if already is not None:
            return already

    say(f"guarded vision start: deadline {args.deadline:.0f}s, then automatic "
        f"restore. Expect ~7 min of downtime — flipping "
        f"`language_model_only` invalidates vLLM's compile cache either way.")

    if not stop_running("try-vision replaces it with the vision config",
                        STOP_WAIT_S):
        die("could not stop the running server; not attempting vision. The "
            "card was never re-claimed, so nothing has changed.", RC_FAIL)

    extra = [*VISION_ARGS, *args.vllm_args]
    if args.vllm_args:
        say(f"experiment arguments on the attempt only: {' '.join(args.vllm_args)}")
    if args.uds:
        say("attempt serves vLLM on a Unix socket behind this launcher's proxy; "
            "the restore uses one too, unconditionally")
    rc = cmd_start(start_namespace(args, extra, args.deadline, uds=args.uds,
                                   model=args.model))
    if rc != RC_OK:
        # A pre-exec ARM refusal means the child never ran, so there is nothing
        # to restore from and nothing was disturbed — say so instead of
        # bouncing a server that is already down for a different reason.
        if rc in (RC_DENIED, RC_WOULD_BLOCK, RC_ARM_ERROR):
            say("ARM refused the vision attempt before anything started; the "
                "server is down and no restore was attempted. Re-run "
                "`dsh-serve start` when the card is free.")
            return rc
        # await_ready already captured the evidence, while the server was up.
        return restore_known_good(args, "the vision server never answered")

    say("vision server is up; running the end-to-end image test")
    passed, detail = image_probe(args.port, attempt_profile["served_model_name"])
    if not passed:
        say(f"IMAGE TEST FAILED: {detail}")
        capture_unreachable_evidence(
            args.port, f"vision server answered /health but failed the image "
                       f"test: {detail}")
        return restore_known_good(args, "the image test failed")

    mark_vision_proven(args.port)
    used = read_gpu_used_mib()
    say(f"VISION VERIFIED end to end: {detail}")
    say(f"leaving it serving on http://{HOST}:{args.port}"
        f"{'' if used is None else f'; {used} MiB VRAM in use'}. "
        "`dsh-serve start` (no try-vision) returns to text-only.")
    if args.port != args.restore_port:
        say(f"⚠️ this is port {args.port}, NOT the shipped {args.restore_port}. "
            "~/.dsh/settings.yaml and the fleet chat's backend both name the "
            "shipped port and neither was touched, so nothing is pointing here "
            "yet. A permanent move is a two-consumer seam, not this verb's job.")
    return RC_OK


# --------------------------------------------------------------------------
# stop / status
# --------------------------------------------------------------------------

def cmd_stop(args: argparse.Namespace) -> int:
    """Give the card back, and prove it.

    On the `--uds` path (default for `start` since 2026-09-04), an in-flight
    request is cut slightly EARLIER than on direct TCP: the proxy is torn
    down before the engine (`cmd_supervise`, "before the engine, so the TCP
    port starts refusing immediately"), so the client sees the port refuse
    rather than the engine's own shutdown sequence being the first thing it
    observes. Not a new risk — `stop` always cuts rather than drains either
    way (`shutdown_timeout` defaults to 0) — just a documented behavior
    difference now that it is what most operators meet by default.
    """
    live = read_state()
    if not live:
        say(f"no {state_path()} — nothing started by this launcher is running")
        return RC_OK if not port_in_use(live_port(live)) else RC_FAIL
    supervisor = live.get("supervisor_pid")
    supervisor_ticks = live.get("supervisor_start_ticks")
    wrapper = live.get("wrapper_pid")
    wrapper_ticks = live.get("wrapper_start_ticks")
    phase = state_phase(live)
    arbitrated = live.get("arbitrated")

    def wrapper_holds_the_lease() -> bool:
        """Whether the recorded wrapper is a process whose exit means something.

        Only `arm run` and a start still in flight qualify. Unclaimed, a
        supervisor records its own parent — the transient `start` process — and
        that parent can be the very process calling `stop`: `try-vision` stops
        the server it started from inside the verb that started it. Waiting for
        that to exit is a wait for ourselves.
        """
        if not pid_alive(wrapper, wrapper_ticks):
            return False
        if wrapper in (os.getpid(), os.getppid()):
            return False
        return bool(arbitrated) or phase == "starting"

    def ours_alive() -> bool:
        return pid_alive(supervisor, supervisor_ticks) or wrapper_holds_the_lease()

    if not ours_alive():
        say(f"recorded {'wrapper' if phase == 'starting' else 'supervisor'} pid "
            f"{wrapper if phase == 'starting' else supervisor} is gone; "
            "clearing stale state")
        try:
            state_path().unlink()
        except OSError:
            pass
        return RC_OK

    # Signal the wrapper, not the supervisor: `arm run` forwards SIGTERM to its
    # child's group and then releases only after that child exits — which is
    # after the supervisor has proved the VRAM came back. Mid-start there is no
    # supervisor yet and the wrapper is the only thing to signal, which is the
    # whole reason `start` records one before it has anything to serve.
    target = wrapper if wrapper_holds_the_lease() else supervisor
    say(f"stopping{' a start in flight' if phase == 'starting' else ''}: "
        f"SIGTERM to pid {target}; waiting for the card to come back")
    try:
        os.kill(target, signal.SIGTERM)
    except ProcessLookupError:
        pass

    baseline = live.get("vram_baseline_mib")
    deadline = time.monotonic() + args.timeout
    while time.monotonic() < deadline:
        # The supervisor may have got as far as recording a baseline after this
        # verb read the file; without re-reading, its own evidence for whether
        # the card came back would be thrown away.
        if baseline is None:
            baseline = (read_state() or {}).get("vram_baseline_mib")
        if not ours_alive():
            break
        time.sleep(0.5)
    else:
        used = read_gpu_used_mib()
        say(f"NOT STOPPED: pid {target} is still alive after "
            f"{args.timeout:.0f}s. VRAM in use: "
            f"{'unreadable' if used is None else str(used) + ' MiB'}. It holds "
            f"the {POOL} lease on purpose while the card is not demonstrably "
            f"free — see {log_path()}.")
        return RC_VRAM_HELD

    if baseline is None and phase == "starting":
        # No baseline was ever recorded, and the supervisor records one BEFORE
        # it spawns vLLM: nothing of ours reached the card, so there is nothing
        # to prove came back.
        try:
            state_path().unlink()
        except OSError:
            pass
        say("stopped before the server was launched; nothing of this "
            f"launcher's had loaded on the card{'' if not arbitrated else f'; {POOL} lease released'}")
        return RC_OK

    used = read_gpu_used_mib()
    if used is None:
        say(f"NOT CONFIRMED: the supervisor exited, but nvidia-smi cannot be "
            "read here, so the VRAM's return is unverified. Do not treat the "
            "card as free.")
        return RC_VRAM_HELD
    if baseline is not None and used > baseline + VRAM_RETURNED_TOLERANCE_MIB:
        say(f"NOT CONFIRMED: the supervisor exited but {used} MiB is still in "
            f"use against a {baseline} MiB baseline. Run `arm audit`.")
        return RC_VRAM_HELD

    say(f"stopped; VRAM in use {used} MiB"
        f"{'' if baseline is None else f' (baseline {baseline} MiB)'}"
        f"{f'; {POOL} lease released' if arbitrated else ''}")
    return RC_OK


def live_port(live: dict | None) -> int:
    return (live or {}).get("port") or PORT


def cmd_status(_args: argparse.Namespace) -> int:
    live = read_state()
    used = read_gpu_used_mib_quick()
    used_txt = "unreadable" if used is None else f"{used} MiB"
    port = live_port(live)
    if not live:
        say(f"not running under this launcher; port {port} "
            f"{'IS' if port_in_use(port) else 'is not'} in use; "
            f"VRAM in use {used_txt}")
        return RC_FAIL
    if state_phase(live) == "starting":
        alive = pid_alive(live.get("wrapper_pid"), live.get("wrapper_start_ticks"))
        say(f"{'STARTING' if alive else 'STALE STATE (start died)'}: "
            f"{live.get('model')} on {HOST}:{port}, wrapper pid "
            f"{live.get('wrapper_pid')}, requested at {live.get('started_at')}, "
            f"{'arbitrated — may be queued for the ' + POOL + ' lease' if live.get('arbitrated') else 'UNCLAIMED'}, "
            f"VRAM in use {used_txt}, "
            f"/health {'ok' if server_ready_once(port) else 'not answering yet'}")
        return RC_OK if alive else RC_FAIL
    running = pid_alive(live.get("supervisor_pid"),
                        live.get("supervisor_start_ticks"))
    # Named precisely, because "the chat is down" has two very different causes
    # once a proxy is in the path and they need different fixes.
    proxy_pid = live.get("proxy_pid")
    if proxy_pid:
        alive = pid_alive(proxy_pid)
        serving = uds_in_use(Path(live["uds"])) if live.get("uds") else False
        route = (f"proxy {proxy_pid} {'alive' if alive else 'DEAD'} "
                 f"({live.get('host')}:{port} -> {live.get('uds')}, engine "
                 f"socket {'answering' if serving else 'NOT answering'}), ")
    else:
        route = "direct TCP (no proxy), "
    say(f"{'running' if running else 'STALE STATE (supervisor gone)'}: "
        f"{live.get('model')} on {live.get('host')}:{live.get('port')}, "
        f"{route}"
        f"supervisor {live.get('supervisor_pid')}, vllm {live.get('vllm_pid')} "
        f"(group {live.get('vllm_pgid')}), serving since "
        f"{live.get('started_at')} (up "
        f"{format_duration(pid_elapsed_seconds(live.get('vllm_pid')))}), "
        f"{'arbitrated' if live.get('arbitrated') else 'UNCLAIMED'}, "
        f"VRAM in use {used_txt} (baseline {live.get('vram_baseline_mib')} MiB), "
        f"/health {'ok' if server_ready_once(port) else 'not answering'}")
    return RC_OK if running else RC_FAIL


def cmd_models(_args: argparse.Namespace) -> int:
    """List the register and validate each profile — path resolves,
    `config.json` parses — WITHOUT loading it: no ARM, no vLLM, no GPU.

    So a bad path (like the abliterated profile's `/mnt/wsl/models-z/...`
    symlink, unproven from that location until this launcher actually loads
    it) surfaces here, cheaply, rather than five minutes into a cold start.
    """
    register = load_register()
    profiles, default, known_good = (register["PROFILES"],
                                     register["DEFAULT_PROFILE"],
                                     register["KNOWN_GOOD_PROFILE"])
    ok = True
    for name in sorted(profiles):
        profile = profiles[name]
        path = Path(profile["path"])
        tags = []
        if name == default:
            tags.append("default")
        if name == known_good:
            tags.append("known-good")
        tag = f" [{', '.join(tags)}]" if tags else ""
        if not path.is_dir():
            ok = False
            say(f"{name}{tag}: INVALID — {path} does not exist")
            continue
        try:
            with open(path / "config.json") as handle:
                json.load(handle)
        except (OSError, ValueError) as exc:
            ok = False
            say(f"{name}{tag}: INVALID — {path}/config.json: {exc}")
            continue
        say(f"{name}{tag}: {path} — served as {profile['served_model_name']!r}, "
            f"max_model_len {profile['max_model_len']}, "
            f"kv_cache_memory_bytes {profile['kv_cache_memory_bytes']}")
        purpose = profile.get("purpose")
        if purpose:
            say(f"    {purpose}")
    if default not in profiles:
        ok = False
        say(f"DEFAULT_PROFILE {default!r} is not in PROFILES")
    if known_good not in profiles:
        ok = False
        say(f"KNOWN_GOOD_PROFILE {known_good!r} is not in PROFILES")
    return RC_OK if ok else RC_FAIL


# --------------------------------------------------------------------------
# selftest — asserts the question this launcher asks ARM, not ARM's answer
# --------------------------------------------------------------------------

RECORDING_ARM = """#!{python}
import json, os, sys
with open(os.environ["DSH_SERVE_ARGV_LOG"], "a") as handle:
    handle.write(json.dumps(sys.argv[1:]) + "\\n")
if sys.argv[1:2] == ["--help"]:
    sys.exit(0)
if sys.argv[1:2] == ["check"]:
    # Real `arm check --json` output, nesting and all. One live holder and one
    # queued claim, because those two render differently and must not be mixed.
    print(json.dumps({{"decision": {{
        "outcome": "would_block", "code": "busy",
        "reason": "pool 'gpu0' is busy: gpu0-studio-ab4b0b (studio, interactive)",
        "blockers": ["gpu0-studio-ab4b0b", "gpu0-trainer-fa2424"],
        "blockers_detail": [
            {{"id": "gpu0-studio-ab4b0b", "kind": "lease", "app": "studio",
             "prio": "interactive", "purpose": "a MiniMax-H3 render"}},
            {{"id": "gpu0-trainer-fa2424", "kind": "waiter", "app": "trainer",
             "prio": "batch", "purpose": "H3 768px 6000-step"}}]}}}}))
    sys.exit(3)
sys.exit(int(os.environ.get("DSH_SERVE_FAKE_ARM_RC", "0")))
"""

# Backed by a file so a case can move the reading between the baseline and the
# teardown — which is the whole situation worth testing.
# Builtins only: the sandbox PATH holds the doubles and nothing else, so this
# cannot reach `cat`.
FAKE_SMI = """#!/bin/sh
if [ -n "$DSH_SERVE_FAKE_MIB_FILE" ] && [ -f "$DSH_SERVE_FAKE_MIB_FILE" ]; then
    read mib < "$DSH_SERVE_FAKE_MIB_FILE"
    echo "$mib"
else
    echo "${DSH_SERVE_FAKE_MIB:-0}"
fi
"""


class Failure(Exception):
    pass


def check(condition: bool, description: str) -> None:
    if not condition:
        raise Failure(description)


def sandbox(tmp: Path, *, books: bool, arm: bool, smi_mib: str | None = None):
    """A throwaway HOME plus a PATH holding only the doubles this case needs
    (plus the real `git`, for the model register — see below).

    HOME is what isolates it: every path this script uses — the books, the state
    file, the log — is derived from it.
    """
    home = tmp / "home"
    (home / ".local" / "state").mkdir(parents=True, exist_ok=True)
    if books:
        (home / ".aivan_arm").mkdir(parents=True, exist_ok=True)
        (home / ".aivan_arm" / "config.json").write_text('{"consumers": {}}\n')
    bindir = tmp / "bin"
    bindir.mkdir(parents=True, exist_ok=True)
    if arm:
        double = bindir / "arm"
        # An absolute interpreter, so PATH can hold the doubles and nothing
        # else — a real `arm` or a real `nvidia-smi` leaking in would make
        # these cases assert against the box instead of against the launcher.
        double.write_text(RECORDING_ARM.format(python=sys.executable))
        double.chmod(0o755)
    if smi_mib is not None:
        double = bindir / "nvidia-smi"
        double.write_text(FAKE_SMI)
        double.chmod(0o755)
    # `load_register` shells out to the real `git`, deliberately not a
    # double: the register is real committed content on REGISTER_BRANCH, not
    # a behavior this launcher owns and fakes for a test. Every case that
    # spawns a child through `start`/`try-vision` needs it on PATH, so it is
    # here rather than opted in per case.
    path = str(bindir)
    git_bin = shutil.which("git")
    if git_bin:
        path = f"{path}:{Path(git_bin).parent}"
    env = {**os.environ, "HOME": str(home), "PATH": path,
           "DSH_SERVE_ARGV_LOG": str(tmp / "argv.log")}
    if smi_mib is not None:
        env["DSH_SERVE_FAKE_MIB"] = smi_mib
    return env, home


def run_self(env: dict, *argv: str, timeout: float = 120) -> subprocess.CompletedProcess:
    return subprocess.run([sys.executable, os.path.abspath(__file__), *argv],
                          capture_output=True, text=True, env=env, timeout=timeout)


def free_port() -> str:
    """A port nothing is on, so a case never collides with the live server —
    which is exactly what `start`'s own port guard is there to protect."""
    with socket.socket() as probe:
        probe.bind((HOST, 0))
        return str(probe.getsockname()[1])


def case_argv(tmp: Path) -> None:
    """The recorded claim IS the assertion: pool, app, exclusivity and class are
    the question this launcher puts to ARM, independent of any answer."""
    env, _ = sandbox(tmp, books=True, arm=True)
    port = free_port()
    _, default_profile = resolve_profile(None)
    out = run_self(env, "start", "--vllm-bin", "/bin/true", "--port", port,
                   "--ready-timeout", "20")
    recorded = [json.loads(line) for line in
                (tmp / "argv.log").read_text().splitlines()]
    claims = [one for one in recorded if one[:2] == ["run", POOL]]
    check(len(claims) == 1, f"expected exactly one `arm run {POOL}`, got {recorded}")
    argv = claims[0]
    check(argv[argv.index("--app") + 1] == APP, f"--app is not {APP}: {argv}")
    check("--exclusive" in argv, f"claim is not exclusive: {argv}")
    check("--vram" not in argv and "--gb" not in argv,
          f"metered claim on {POOL} is forbidden: {argv}")
    check(argv[argv.index("--prio") + 1] == REGISTERED_PRIO,
          f"--prio is not {REGISTERED_PRIO}: {argv}")
    purpose = argv[argv.index("--purpose") + 1]
    check(default_profile["served_model_name"] in purpose and port in purpose,
          f"--purpose names neither the model nor the port: {purpose!r}")
    check("--" in argv and argv[argv.index("--") + 1] != "vllm",
          "vllm must not be arm run's direct child; the supervisor must be")
    check(any("_supervise" in one for one in argv),
          f"the supervisor is not the wrapped child: {argv}")
    check(out.returncode != RC_OK,
          "start reported success although the double never served anything")


def case_prio_override_needs_reason(tmp: Path) -> None:
    """The TD's ruling, enforced: upward from `fleet` requires a stated why."""
    env, _ = sandbox(tmp, books=True, arm=True)
    out = run_self(env, "start", "--prio", "service", "--vllm-bin", "/bin/true",
                   "--port", free_port())
    check(out.returncode == RC_FAIL, f"expected refusal, got rc {out.returncode}")
    check("--purpose" in out.stderr, f"refusal does not say why: {out.stderr!r}")
    check(not (tmp / "argv.log").exists(),
          "refused, yet it still put a claim to ARM")


def case_would_block_names_who(tmp: Path) -> None:
    """A refusal that says only "GPU busy" sends the operator off to run
    `arm status`. Name the holder — from `blockers_detail` values, never by
    parsing `reason`, whose wording is not a contract."""
    env, _ = sandbox(tmp, books=True, arm=True)
    env["DSH_SERVE_FAKE_ARM_RC"] = "98"
    out = run_self(env, "start", "--vllm-bin", "/bin/true", "--port", free_port(),
                   "--ready-timeout", "20")
    check(out.returncode == RC_WOULD_BLOCK,
          f"expected rc {RC_WOULD_BLOCK}, got {out.returncode}: {out.stderr!r}")
    check("held by studio" in out.stderr,
          f"a live holder must read as 'held by': {out.stderr!r}")
    check("MiniMax-H3 render" in out.stderr,
          f"the holder's purpose is what makes it actionable: {out.stderr!r}")
    # A waiter means the pool may be entirely free and we are standing aside for
    # a queued claim; calling that "held by" would be a lie.
    check("queued behind trainer" in out.stderr,
          f"a waiter must not read as a holder: {out.stderr!r}")


def case_books_present_arm_missing(tmp: Path) -> None:
    """The bottom row of the consumer brief's §4c table: the books say this box
    is arbitrated, so an unreachable `arm` is a refusal, never permission."""
    env, _ = sandbox(tmp, books=True, arm=False)
    out = run_self(env, "start", "--vllm-bin", "/bin/true", "--port", free_port())
