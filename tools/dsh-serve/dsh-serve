          f"supervisor did not take a baseline: {log!r}")


def case_stop_requires_vram_return(tmp: Path) -> None:
    """`stop` must not print "stopped" over a card that is still full."""
    env, home = sandbox(tmp, books=False, arm=False, smi_mib="26000")
    state = home / ".local" / "state" / "dsh-serve"
    state.mkdir(parents=True, exist_ok=True)
    _, default_profile = resolve_profile(None)
    # A stand-in supervisor that dies on the SIGTERM `stop` sends, leaving the
    # card reading 26000 MiB against an 800 MiB baseline: the exact defect —
    # the process is gone and the VRAM is not back.
    stand_in = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(60)"])
    try:
        (state / "state.json").write_text(json.dumps({
            "wrapper_pid": stand_in.pid,
            "wrapper_start_ticks": pid_start_ticks(stand_in.pid),
            "supervisor_pid": stand_in.pid,
            "supervisor_start_ticks": pid_start_ticks(stand_in.pid),
            "vllm_pid": stand_in.pid, "vllm_pgid": stand_in.pid,
            "vram_baseline_mib": 800, "arbitrated": False,
            "host": HOST, "port": int(free_port()),
            "model": default_profile["served_model_name"],
        }))
        out = run_self(env, "stop", "--timeout", "20")
        check(not pid_alive(stand_in.pid), "stop did not signal the recorded pid")
        check(out.returncode == RC_VRAM_HELD,
              f"expected rc {RC_VRAM_HELD}, got {out.returncode}: {out.stderr!r}")
        check("stopped;" not in out.stderr,
              f"said stopped over a full card: {out.stderr!r}")
        check("NOT CONFIRMED" in out.stderr, f"not loud enough: {out.stderr!r}")
    finally:
        if stand_in.poll() is None:
            stand_in.kill()
        stand_in.wait()


def case_refuses_to_release(tmp: Path) -> None:
    """⛔ The requirement that carries the most weight.

    The child exits, the recorded group is empty, and the card is STILL full —
    the exact shape of a surviving `VLLM::EngineCore`. Under a lease the
    supervisor must not exit, because its exit is what releases the lease.
    """
    env, home = sandbox(tmp, books=True, arm=True, smi_mib="0")
    reading = tmp / "vram.txt"
    reading.write_text("0\n")                       # the pre-launch baseline
    env["DSH_SERVE_FAKE_MIB_FILE"] = str(reading)
    # A stand-in "vllm" that leaves the card full behind it and exits.
    leaky = tmp / "leaky-vllm"
    leaky.write_text(f'#!/bin/sh\necho 26000 > "{reading}"\nexit 0\n')
    leaky.chmod(0o755)

    supervisor = subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "_supervise",
         "--vllm-bin", str(leaky), "--arbitrated", "--vram-timeout", "3",
         "--port", free_port(), "--profile", "unsloth"],
        stderr=subprocess.PIPE, stdout=subprocess.DEVNULL, text=True, env=env)
    try:
        deadline = time.monotonic() + 45
        while time.monotonic() < deadline and supervisor.poll() is None:
            time.sleep(0.25)
        check(supervisor.poll() is None,
              f"the supervisor EXITED (rc {supervisor.returncode}) over a full "
              "card — the lease would have been released")
        supervisor.terminate()
        try:
            supervisor.wait(timeout=15)
        except subprocess.TimeoutExpired:
            supervisor.kill()
            supervisor.wait()
        log = (home / ".local" / "state" / "dsh-serve" / "server.log")
        text = log.read_text() if log.exists() else (supervisor.stderr.read() or "")
    finally:
        if supervisor.poll() is None:
            supervisor.kill()
            supervisor.wait()
    check("REFUSING TO RELEASE" in text, f"held, but said nothing: {text!r}")
    check("26000" in text, f"the refusal does not state what it saw: {text!r}")


def write_fake_state(home: Path, payload: dict) -> Path:
    where = home / ".local" / "state" / "dsh-serve" / "state.json"
    where.parent.mkdir(parents=True, exist_ok=True)
    where.write_text(json.dumps(payload, indent=2) + "\n")
    return where


def case_stop_mid_start(tmp: Path) -> None:
    """⛔ `stop` must reach a start that has not produced a server yet.

    Until 2026-08-27 nothing was recorded between `start` spawning the wrapper
    and the supervisor's own record minutes later, so a `stop` in that window
    found no state, said "nothing is running" and exited 0 — while the start
    went on to take the card unattended. The window is unbounded when the ARM
    claim is queued. A machine caller can hit it on any stop at the seam.
    """
    env, home = sandbox(tmp, books=False, arm=False, smi_mib="0")
    victim = subprocess.Popen(["sleep", "120"], start_new_session=True,
                              stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL)
    _, default_profile = resolve_profile(None)
    try:
        state = write_fake_state(home, {
            "phase": "starting",
            "wrapper_pid": victim.pid,
            "wrapper_start_ticks": pid_start_ticks(victim.pid),
            "arbitrated": False, "host": HOST, "port": int(free_port()),
            "uds": None, "model": default_profile["served_model_name"],
            "serve_args": [],
            "started_at": "2026-08-27T00:00:00+0300",
        })
        out = run_self(env, "stop", "--timeout", "30")
        check(out.returncode == RC_OK,
              f"expected rc {RC_OK}, got {out.returncode}: {out.stderr!r}")
        check(victim.poll() is not None or not pid_alive(victim.pid),
              "the in-flight start was left running — this is the orphaned-card "
              "bug the early record exists to close")
        check(not state.exists(), "the starting record was left behind")
    finally:
        if victim.poll() is None:
            victim.kill()
        victim.wait()


def case_already_running(tmp: Path) -> None:
    """`start` distinguishes "already up" from "failed", and `--if-not-running`
    accepts ONLY the configuration it asked for."""
    env, home = sandbox(tmp, books=False, arm=False, smi_mib="0")
    holder = subprocess.Popen(["sleep", "120"], start_new_session=True,
                              stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL)
    try:
        port = free_port()
        # The child resolves the default profile's path under the sandbox
        # HOME; this process resolved it under the real one. Same list,
        # different root.
        _, default_profile = resolve_profile(None)
        sandboxed = [one.replace(str(default_profile["path"]),
                                 str(home / "models" / default_profile["path"].name))
                     for one in vllm_args(default_profile, int(port))]
        record = {
            "phase": "serving",
            "supervisor_pid": holder.pid,
            "supervisor_start_ticks": pid_start_ticks(holder.pid),
            "wrapper_pid": holder.pid,
            "wrapper_start_ticks": pid_start_ticks(holder.pid),
            "vllm_pid": holder.pid, "vllm_pgid": holder.pid,
            "arbitrated": False, "host": HOST, "port": int(port), "uds": None,
            "model": default_profile["served_model_name"], "vram_baseline_mib": 0,
            "serve_args": sandboxed,
            "started_at": "2026-08-27T00:00:00+0300",
        }
        write_fake_state(home, record)
        # --no-uds pinned explicitly on every call below: the fake "already
        # running" record was built from `vllm_args()` with no `uds`
        # argument, i.e. direct-TCP args. This case is about the
        # already-running/config-mismatch decision, not about transport, so
        # it must not ride whatever `start`'s own uds default happens to be
        # — that already broke it once, 2026-09-04, when the default flipped.
        out = run_self(env, "start", "--port", port, "--vllm-bin", "/bin/true",
                       "--no-uds")
        check(out.returncode == RC_ALREADY_RUNNING,
              f"expected rc {RC_ALREADY_RUNNING}, got {out.returncode}")

        out = run_self(env, "start", "--if-not-running", "--port", port,
                       "--vllm-bin", "/bin/true", "--no-uds")
        check(out.returncode == RC_OK,
              f"a matching configuration must be accepted: rc {out.returncode}"
              f": {out.stderr!r}")

        record["serve_args"] = [*sandboxed, "--no-language-model-only"]
        write_fake_state(home, record)
        out = run_self(env, "start", "--if-not-running", "--port", port,
                       "--vllm-bin", "/bin/true", "--no-uds")
        check(out.returncode == RC_CONFIG_MISMATCH,
              f"a DIFFERENT configuration must fail loudly, got rc "
              f"{out.returncode} — accepting it would hand the caller a server "
              "it did not ask for")
    finally:
        if holder.poll() is None:
            holder.kill()
        holder.wait()


def case_json_payload(tmp: Path) -> None:
    """`--json` is the machine-readable surface: one object on stdout, prose
    untouched on stderr, and an object on the refusal paths too."""
    env, _ = sandbox(tmp, books=False, arm=False, smi_mib="0")
    out = run_self(env, "status", "--json")
    payload = json.loads(out.stdout)
    check(payload["schema_version"] == JSON_SCHEMA_VERSION,
          f"unversioned payload: {payload!r}")
    # A consumer distinguishes an ABSENT key (an older launcher — warn and
    # proceed) from an explicit null (known-unknown), so every key ships on
    # every call whatever its value.
    for key in ("running", "healthy", "vision", "model_served",
                "model_requested", "profile", "phase", "endpoint"):
        check(key in payload, f"{key} missing — absence means 'older launcher' "
                              f"to a consumer: {payload!r}")
    check(payload["running"] is False and payload["rc"] == RC_FAIL,
          f"a launcher with no state is not running: {payload!r}")
    check(out.stderr.startswith("dsh-serve: "),
          f"the prose left stderr: {out.stderr!r}")
    check("\n" not in out.stdout.strip(),
          f"stdout must be exactly one object: {out.stdout!r}")


def case_status_never_wedges(tmp: Path) -> None:
    """⛔ A read-only verb answers, whatever `nvidia-smi` is doing.

    Reported by studio3 2026-08-27 as `status --json` never returning: they
    killed it at 20 s, which is exactly this launcher's `nvidia-smi` timeout,
    and `status --json` read the card TWICE. A stalled binary could hold a
    read-only verb for 40 s before it said anything, and a machine consumer
    that times out first gets nothing to classify at all.

    The refusal is typed, not silent: `vram_used_mib` is null and the prose
    says `unreadable`. None is UNKNOWN and never zero.
    """
    env, _ = sandbox(tmp, books=False, arm=False)
    stalled = tmp / "bin" / "nvidia-smi"
    # An ABSOLUTE interpreter and no PATH lookup inside: the sandbox's PATH
    # holds only its own doubles, so a `#!/bin/sh` stub calling `sleep` exits
    # 127 at once and the case passes while stalling nothing. That is the
    # green-and-proving-nothing shape this very case exists to catch.
    stalled.write_text(f"#!{sys.executable}\nimport time\ntime.sleep(120)\n")
    stalled.chmod(0o755)

    began = time.monotonic()
    out = run_self(env, "status", "--json", timeout=60)
    took = time.monotonic() - began
    check(took < SMI_QUICK_TIMEOUT_S + 5,
          f"status --json took {took:.1f}s against a stalled nvidia-smi — a "
          "consumer cannot wait that long for a read-only verb")
    payload = json.loads(out.stdout)
    check(payload["elapsed_seconds"] <= took,
          f"elapsed_seconds {payload['elapsed_seconds']} exceeds the wall time "
          f"{took:.1f}s this verb actually took")
    check(payload["vram_used_mib"] is None,
