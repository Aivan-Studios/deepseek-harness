def _reap_state_pids(home: Path) -> None:
    """Kill whatever a case left running, by the PIDs recorded in state.json —
    never by pattern. Shared by cases whose whole point is a server that is
    still up when the verb under test returns (a wedge deliberately left for a
    human, or here, a deliberately-mute double left for this case to clean up)."""
    state = home / ".local" / "state" / "dsh-serve" / "state.json"
    if not state.exists():
        return
    live = json.loads(state.read_text())
    for pid in (live.get("vllm_pgid"), live.get("supervisor_pid"),
               live.get("proxy_pid")):
        if not pid:
            continue
        try:
            os.killpg(pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError, OSError):
            try:
                os.kill(pid, signal.SIGKILL)
            except (ProcessLookupError, OSError):
                pass


