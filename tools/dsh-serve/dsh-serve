# A real HTTP double whose /health answer is controlled by a file the test
# flips live, and which logs every hit it receives with a timestamp — so the
# two cases below synchronize on OBSERVED probes, never on assumed timing.
# `cmd_supervise`'s own probe schedule (30s apart, first one immediate) is
# real and unmocked here, same reasoning as the direct-TCP warning cases:
# faking the interval would test a different schedule than production runs.
MID_SESSION_HEALTH_DOUBLE = '''#!{python}
import http.server, os, sys, time

port = int(sys.argv[sys.argv.index("--port") + 1])
flag = os.environ["DSH_SERVE_TEST_HEALTH_FLAG"]
hits = os.environ["DSH_SERVE_TEST_HEALTH_HITS"]

class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path != "/health":
            self.send_response(404)
            self.end_headers()
            return
        try:
            up = open(flag).read().strip() != "down"
        except OSError:
            up = True
        with open(hits, "a") as f:
            f.write(f"{{time.time()}} {{'up' if up else 'down'}}\\n")
        self.send_response(200 if up else 503)
        self.end_headers()
        if up:
            self.wfile.write(b"OK")

    def log_message(self, *args):
        pass

http.server.HTTPServer(("127.0.0.1", port), Handler).serve_forever()
'''


def _wait_for_hit_count(hits_path: Path, n: int, timeout: float) -> list[str]:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if hits_path.exists():
            lines = hits_path.read_text().splitlines()
            if len(lines) >= n:
                return lines
        time.sleep(0.5)
    got = hits_path.read_text().splitlines() if hits_path.exists() else []
    raise Failure(f"timed out waiting for {n} /health hits; got {len(got)}: {got}")


def _mid_session_double(tmp: Path, flag: Path, hits: Path) -> Path:
    flag.write_text("up")
    double = tmp / "toggle-vllm"
    double.write_text(MID_SESSION_HEALTH_DOUBLE.format(python=sys.executable))
    double.chmod(0o755)
    return double


def case_mid_session_capture_fires(tmp: Path) -> None:
    """The mid-session watchdog (`MID_SESSION_PROBE_INTERVAL_S` /
    `MID_SESSION_MISS_THRESHOLD`, TD-approved 2026-09-04 as tier 1 of the
    forensic-gap pricing) must capture evidence once a server that was
    healthy stops answering — the gap the startup-only capture never covered.

    Synchronizes on the double's own hit log, not on assumed timing: the real
    30s-apart schedule is what production runs, so this waits for OBSERVED
    probes rather than sleeping a guessed duration.
    """
    env, home = sandbox(tmp, books=False, arm=False, smi_mib="0")
    flag, hits = tmp / "health-flag", tmp / "health-hits"
    double = _mid_session_double(tmp, flag, hits)
    env["DSH_SERVE_TEST_HEALTH_FLAG"] = str(flag)
    env["DSH_SERVE_TEST_HEALTH_HITS"] = str(hits)
    try:
        out = run_self(env, "start", "--vllm-bin", str(double), "--no-uds",
                       "--port", free_port(), "--ready-timeout", "20")
        check(out.returncode == RC_OK,
              f"the double should have come up clean: rc {out.returncode}: "
              f"{out.stderr!r}")
        baseline = len(_wait_for_hit_count(hits, 1, timeout=10))
        flag.write_text("down")
        # Two NEW misses since the flip — the threshold — must produce a
        # capture; wait past a comfortable margin beyond two real intervals.
        lines = _wait_for_hit_count(hits, baseline + 2, timeout=90)
        check(lines[-1].endswith("down") and lines[-2].endswith("down"),
              f"expected the two hits after the flip to see 'down': {lines!r}")
        deadline = time.monotonic() + 15
        log_text = ""
        while time.monotonic() < deadline:
            log_text = (home / ".local" / "state" / "dsh-serve"
                       / "server.log").read_text()
            if "mid-session" in log_text:
                break
            time.sleep(0.5)
        check("mid-session" in log_text,
              f"the mid-session capture warning never printed: {log_text[-800:]!r}")
        captures = sorted((home / ".local" / "state" / "dsh-serve"
                           / "unreachable").glob("unreachable-*.txt"))
        check(captures, "the miss threshold was crossed without a capture file")
        check("mid-session" in captures[-1].read_text(),
              f"the capture's own note does not say mid-session: "
              f"{captures[-1].read_text()[:400]!r}")
    finally:
        _reap_state_pids(home)


